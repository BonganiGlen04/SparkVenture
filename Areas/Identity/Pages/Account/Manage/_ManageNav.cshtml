@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();

    const string baseClass = "flex items-center whitespace-nowrap rounded-xl px-4 py-3 text-sm font-semibold transition";

    string Cls(string? navClass) => navClass == "active"
        ? baseClass + " bg-blue-600 text-white shadow-lg shadow-blue-200"
        : baseClass + " text-blue-900 hover:bg-blue-50";
}

<ul class="flex gap-1 overflow-x-auto md:flex-col md:overflow-visible">
    <li><a class="@Cls(ManageNavPages.IndexNavClass(ViewContext))" id="profile" asp-page="./Index">Profile</a></li>
    <li><a class="@Cls(ManageNavPages.EmailNavClass(ViewContext))" id="email" asp-page="./Email">Email</a></li>
    <li><a class="@Cls(ManageNavPages.ChangePasswordNavClass(ViewContext))" id="change-password" asp-page="./ChangePassword">Password</a></li>
    @if (hasExternalLogins)
    {
        <li id="external-logins"><a class="@Cls(ManageNavPages.ExternalLoginsNavClass(ViewContext))" id="external-login" asp-page="./ExternalLogins">External logins</a></li>
    }
    <li><a class="@Cls(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext))" id="two-factor" asp-page="./TwoFactorAuthentication">Two-factor authentication</a></li>
    <li><a class="@Cls(ManageNavPages.PersonalDataNavClass(ViewContext))" id="personal-data" asp-page="./PersonalData">Personal data</a></li>
</ul>
