@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="text-xl font-extrabold text-blue-950">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" class="mt-6 max-w-md space-y-5">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>

    <div>
        <label asp-for="Username" class="block text-sm font-bold text-blue-950"></label>
        <input asp-for="Username" disabled
               class="mt-2 w-full rounded-xl border border-blue-100 bg-slate-50 px-4 py-3 text-slate-500" />
    </div>

    <div>
        <label asp-for="Input.PhoneNumber" class="block text-sm font-bold text-blue-950"></label>
        <input asp-for="Input.PhoneNumber"
               class="mt-2 w-full rounded-xl border border-blue-100 bg-white px-4 py-3 text-slate-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none" />
        <span asp-validation-for="Input.PhoneNumber" class="mt-1 block text-sm text-red-600"></span>
    </div>

    <button id="update-profile-button" type="submit"
            class="rounded-xl bg-blue-600 px-6 py-3 font-bold text-white shadow-lg shadow-blue-200 hover:bg-blue-700">
        Save
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
