@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<main class="grid min-h-screen lg:grid-cols-2">
    <!-- BRAND PANEL -->
    <section class="bg-gradient-to-br relative hidden overflow-hidden from-blue-950 via-blue-900 to-blue-700 px-12 py-12 text-white lg:flex lg:flex-col lg:justify-between">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="shrink-0">
            <img src="~/images/footer-logo.png"
                 alt="SparkVenture"
                 class="h-10 w-auto object-contain" />
        </a>

        <div class="max-w-md">
            <p class="text-xs font-bold tracking-widest text-sky-300 uppercase">Welcome back</p>
            <h2 class="mt-4 text-4xl leading-tight font-extrabold">
                Pick up where you left off
                <span class="text-sky-300">building.</span>
            </h2>
            <p class="mt-5 leading-7 text-blue-100">
                Sign in to track your finances, find opportunities and keep your business on track.
            </p>
        </div>

        <p class="text-xs text-blue-200">Build. Grow. Thrive.</p>
    </section>

    <!-- FORM PANEL -->
    <section class="bg-gradient-to-br flex items-center justify-center from-blue-50 via-white to-sky-100 px-5 py-12 lg:px-8">
        <div class="w-full max-w-md">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="mb-8 block lg:hidden">
                <img src="~/images/nav-logo.png"
                     alt="SparkVenture"
                     class="h-10 w-auto object-contain" />
            </a>

            <div class="rounded-3xl border border-blue-100 bg-white p-8 shadow-xl sm:p-10">
                <p class="text-xs font-bold tracking-widest text-blue-600 uppercase">Sign in</p>
                <h1 class="mt-3 text-3xl font-extrabold text-blue-950">Log in to your account</h1>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                    New here?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-blue-600 hover:text-blue-800">Create an account</a>
                </p>

                <form id="account" method="post" class="mt-8 space-y-5">
                    <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700 empty:hidden" role="alert"></div>

                    <div>
                        <label asp-for="Input.Email" class="mb-2 block text-sm font-semibold text-blue-950">Email</label>
                        <input asp-for="Input.Email"
                               class="w-full rounded-xl border border-blue-100 bg-white px-4 py-3 text-sm text-slate-700 placeholder-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="mt-2 block text-xs font-semibold text-red-600"></span>
                    </div>

                    <div>
                        <div class="mb-2 flex items-center justify-between">
                            <label asp-for="Input.Password" class="block text-sm font-semibold text-blue-950">Password</label>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-xs font-bold text-blue-600 hover:text-blue-800">
                                Forgot your password?
                            </a>
                        </div>
                        <input asp-for="Input.Password"
                               class="w-full rounded-xl border border-blue-100 bg-white px-4 py-3 text-sm text-slate-700 placeholder-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Enter your password" />
                        <span asp-validation-for="Input.Password" class="mt-2 block text-xs font-semibold text-red-600"></span>
                    </div>

                    <label asp-for="Input.RememberMe" class="flex items-center gap-3 text-sm font-semibold text-blue-950">
                        <input asp-for="Input.RememberMe" class="h-4 w-4 rounded border-blue-200 text-blue-600 focus:ring-blue-200" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>

                    <button id="login-submit"
                            type="submit"
                            class="w-full rounded-xl bg-blue-600 px-6 py-4 text-center font-bold text-white shadow-lg shadow-blue-200 hover:bg-blue-700">
                        Log in
                    </button>

                    <p class="text-center text-sm text-slate-600">
                        Didn't get a confirmation email?
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="font-bold text-blue-600 hover:text-blue-800">Resend it</a>
                    </p>
                </form>

                <!-- EXTERNAL LOGINS -->
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="mt-8 border-t border-blue-100 pt-6">
                        <p class="text-center text-sm font-semibold text-slate-500">Or continue with</p>

                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-4 flex flex-col gap-3 sm:flex-row">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Log in using your @provider.DisplayName account"
                                        class="flex-1 rounded-xl border border-blue-600 bg-white px-5 py-3 text-sm font-bold text-blue-600 hover:bg-blue-50">
                                    @provider.DisplayName
                                </button>
                            }
                        </form>
                    </div>
                }
            </div>

            <p class="mt-6 text-center text-sm">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="font-semibold text-slate-500 hover:text-blue-600">← Back to home</a>
            </p>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        /* jQuery Unobtrusive Validation adds these classes to invalid inputs */
        .input-validation-error {
            border-color: #ef4444 !important;
        }
    </style>
}
