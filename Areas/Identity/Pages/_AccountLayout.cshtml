<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SparkVenture</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
</head>
<body class="bg-gradient-to-br min-h-screen from-blue-50 via-white to-sky-100 text-slate-700 antialiased">
@{
    var initial = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "?" : User.Identity!.Name!.Substring(0, 1).ToUpperInvariant();
}

<header class="sticky top-0 z-20 border-b border-blue-100 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
        <a href="@(Url.Action("Index", "Dashboard") ?? "/")" class="shrink-0">
            <img src="~/images/nav-logo.png" alt="SparkVenture" class="h-10 w-auto object-contain" />
        </a>

        <div class="flex items-center gap-3">
            <a href="@(Url.Action("Index", "Dashboard") ?? "/")"
               class="rounded-xl border border-blue-600 px-4 py-2 text-sm font-semibold text-blue-600 hover:bg-blue-50">
                Back to dashboard
            </a>

            <details class="relative">
                <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full bg-blue-100 text-sm font-extrabold text-blue-700 hover:bg-blue-200"
                         aria-label="Account menu">
                    @initial
                </summary>
                <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-blue-100 bg-white p-2 shadow-xl">
                    <p class="truncate px-3 py-2 text-xs text-slate-500">@User.Identity?.Name</p>
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")">
                        <button type="submit"
                                class="w-full rounded-lg px-3 py-2 text-left text-sm font-semibold text-red-600 hover:bg-red-50">
                            Sign out
                        </button>
                    </form>
                </div>
            </details>
        </div>
    </div>
</header>

<main class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    @RenderBody()
</main>

<footer class="mx-auto max-w-5xl px-5 pb-10 text-xs text-slate-500 lg:px-8">
    <p>© @DateTime.Now.Year SparkVenture. All rights reserved.</p>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
