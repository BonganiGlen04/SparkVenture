@model SparkVenture.ViewModels.CashbookEntryDetailsViewModel
@{
    ViewData["Title"] = "Cashbook Entry";
    Layout = "_DashboardLayout";
    var entry = Model.Entry;
}
<a asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-sm font-semibold text-blue-600 hover:text-blue-800">← Back to Cashbook</a>
<div class="mt-5 max-w-2xl rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-xs font-bold uppercase tracking-widest text-blue-600">@Model.BusinessName</p>
    <h1 class="mt-2 text-2xl font-extrabold text-blue-950">@entry.Description</h1>
    <p class="mt-3 text-3xl font-extrabold @(entry.Direction == "In" ? "text-emerald-700" : "text-red-700")">@(entry.Direction == "In" ? "+" : "−") R @entry.Amount.ToString("N2")</p>
    <dl class="mt-7 divide-y divide-blue-100 text-sm">
        <div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Date</dt><dd class="font-semibold text-blue-950">@entry.EntryDate.ToString("dd MMM yyyy")</dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Direction</dt><dd class="font-semibold text-blue-950">@(entry.Direction == "In" ? "Money in" : "Money out")</dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Type</dt><dd class="font-semibold text-blue-950">@entry.EntryType</dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Category</dt><dd class="font-semibold text-blue-950">@(entry.CategoryName ?? "—")</dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Reference</dt><dd class="font-semibold text-blue-950">@(entry.Reference ?? "—")</dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Status</dt><dd class="font-semibold text-blue-950">@entry.Status</dd></div>
    </dl>
    @if (entry.CanReverse)
    {
        <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4"><p class="mb-3 text-xs text-amber-900">To correct this entry, reverse it and record the correct transaction. The original remains in the history.</p>
            <form asp-action="Reverse" method="post" onsubmit="return confirm('Reverse this posted transaction? This action cannot be undone.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="businessId" value="@Model.BusinessId" />
                <input type="hidden" name="id" value="@entry.CashbookEntryId" />
                <button class="rounded-xl border border-red-200 bg-white px-5 py-2 text-sm font-bold text-red-700 hover:bg-red-50" type="submit">Reverse entry</button>
            </form>
        </div>
    }
    @if (entry.EntryType == "InvoicePayment")
    {
        <p class="mt-5 text-xs text-slate-500">This entry came from a payment allocation. Reverse the underlying payment through the payments workflow, not in the cashbook.</p>
    }
</div>
