@model SparkVenture.ViewModels.CashbookIndexViewModel
@{
    ViewData["Title"] = "Business Cashbook";
    Layout = "_DashboardLayout";
}
<div class="mb-8">
    <a asp-controller="Businesses" asp-action="Details" asp-route-id="@Model.BusinessId" class="text-sm font-semibold text-blue-600 hover:text-blue-800">← Back to Business Profile</a>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="text-xs font-bold uppercase tracking-widest text-blue-600">Phase C · Business finances</p>
            <h1 class="mt-2 text-3xl font-extrabold text-blue-950 sm:text-4xl">Cashbook</h1>
            <p class="mt-2 text-sm text-slate-600">Track money received and paid by <strong>@Model.BusinessName</strong>.</p>
        </div>
        @if (Model.CanEdit)
        {
            <div class="flex flex-wrap gap-2">
                <a asp-action="Create" asp-route-businessId="@Model.BusinessId" asp-route-direction="In" class="rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white hover:bg-emerald-700">＋ Money in</a>
                <a asp-action="Create" asp-route-businessId="@Model.BusinessId" asp-route-direction="Out" class="rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white hover:bg-blue-700">＋ Expense</a>
            </div>
        }
    </div>
</div>
@if (TempData["SuccessMessage"] is string notice)
{
    <div role="status" class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-800">@notice</div>
}
<div class="mb-6 grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-slate-500">Money received (this period)</p><p class="mt-2 text-2xl font-extrabold text-emerald-700">R @Model.MoneyIn.ToString("N2")</p></div>
    <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-slate-500">Money paid (this period)</p><p class="mt-2 text-2xl font-extrabold text-red-700">R @Model.MoneyOut.ToString("N2")</p></div>
    <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-slate-500">Net cash movement</p><p class="mt-2 text-2xl font-extrabold text-blue-950">R @Model.NetMovement.ToString("N2")</p></div>
</div>
<div class="mb-6 rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-center gap-3">
        <form asp-action="Index" method="get" class="flex flex-wrap items-end gap-2">
            <input type="hidden" name="businessId" value="@Model.BusinessId" />
            <div><label for="month" class="mb-1 block text-xs font-bold text-slate-600">Month</label><input id="month" name="month" type="month" value="@Model.Month" class="rounded-xl border border-blue-200 bg-white px-3 py-2 text-sm text-blue-950" /></div>
            <button type="submit" class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700">Show</button>
        </form>
        <div class="flex flex-wrap gap-2 sm:ml-auto">
            <a asp-action="Reports" asp-route-businessId="@Model.BusinessId" class="rounded-xl border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50">Financial summary</a>
            <a asp-action="Categories" asp-route-businessId="@Model.BusinessId" class="rounded-xl border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50">Expense categories</a>
            <a asp-action="Export" asp-route-businessId="@Model.BusinessId" asp-route-month="@Model.Month" class="rounded-xl border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50">Export CSV</a>
        </div>
    </div>
</div>
<div class="overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-sm">
    <div class="border-b border-blue-100 p-5"><h2 class="text-lg font-extrabold text-blue-950">Transaction history</h2><p class="mt-1 text-xs text-slate-500">@Model.TotalEntries posted transactions in this period · displaying up to 150 entries, including corrections</p></div>
    @if (Model.Entries.Count == 0)
    {
        <div class="px-5 py-12 text-center"><p class="text-lg font-bold text-blue-950">No transactions for this month</p><p class="mt-2 text-sm text-slate-600">Use Money in or Expense to record your first cashbook movement.</p></div>
    }
    else
    {
        <div class="divide-y divide-blue-50">
            @foreach (var item in Model.Entries)
            {
                <a asp-action="Details" asp-route-businessId="@Model.BusinessId" asp-route-id="@item.CashbookEntryId" class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 transition hover:bg-blue-50">
                    <div class="min-w-0">
                        <p class="font-semibold text-blue-950">@item.Description</p>
                        <p class="mt-1 text-xs text-slate-500">@item.EntryDate.ToString("dd MMM yyyy") · @(item.CategoryName ?? item.EntryType) · @item.Status</p>
                        @if (item.EntryType == "Reversal") { <p class="mt-1 text-xs font-semibold text-amber-700">Correction record (not counted again)</p> }
                    </div>
                    <div class="text-right"><p class="font-extrabold @(item.Direction == "In" ? "text-emerald-700" : "text-red-700")">@(item.Direction == "In" ? "+" : "−") R @item.Amount.ToString("N2")</p><span class="text-xs font-semibold text-blue-600">Details →</span></div>
                </a>
            }
        </div>
    }
</div>
<p class="mt-5 text-xs leading-5 text-slate-500">Net cash movement is money received minus money paid for the selected period. It is not profit, an opening/closing bank balance, or a tax statement. Entries marked Reversed and their correction records are excluded from totals.</p>
