@model SparkVenture.ViewModels.PaymentsIndexVm
@{ ViewData["Title"] = "Payments"; Layout = "_DashboardLayout"; }
<div class="mb-6 flex flex-wrap items-center justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-blue-600">Phase C4 · @Model.BusinessName</p><h1 class="mt-2 text-3xl font-extrabold text-blue-950">Payments received</h1><p class="mt-2 text-sm text-slate-500">Record and allocate verified receipts to invoices, with matching Cashbook entries.</p></div>@if(Model.CanEdit){<a asp-action="Record" asp-route-businessId="@Model.BusinessId" class="rounded-xl bg-blue-600 px-5 py-3 font-bold text-white">+ Record payment</a>}</div>
@if(TempData["SuccessMessage"] is string msg){<p role="status" class="mb-4 rounded-xl bg-emerald-50 p-4 text-emerald-800">@msg</p>}
<div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800"><strong>Manual recording only.</strong> These are payments you confirm were received outside SparkVenture. This page does not collect card details, move funds or verify EFT settlement automatically.</div>
<div class="overflow-x-auto rounded-2xl border border-blue-100 bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="bg-blue-50 text-blue-950"><tr><th class="p-4">Date</th><th class="p-4">Invoice</th><th class="p-4">Reference</th><th class="p-4">Method</th><th class="p-4">Status</th><th class="p-4 text-right">Amount (R)</th><th class="p-4">Action</th></tr></thead><tbody class="divide-y divide-blue-50">@foreach(var p in Model.Payments){<tr><td class="p-4">@p.ReceivedOn.ToString("dd MMM yyyy")</td><td class="p-4 font-bold">@p.InvoiceNumber</td><td class="p-4">@p.Reference</td><td class="p-4">@p.Method</td><td class="p-4">@p.Status</td><td class="p-4 text-right font-bold">@p.Amount.ToString("N2")</td><td class="p-4">@if(p.CanReverse){<form asp-action="Reverse" method="post" onsubmit="return confirm('Reverse this MANUAL receipt and its cashbook entry?');">@Html.AntiForgeryToken()<input type="hidden" name="businessId" value="@Model.BusinessId"/><input type="hidden" name="id" value="@p.PaymentId"/><button class="rounded-lg border border-red-200 px-3 py-2 text-xs font-bold text-red-700">Reverse</button></form>}</td></tr>}</tbody></table>@if(Model.Payments.Count==0){<p class="p-8 text-center text-slate-500">No allocated payments for this business.</p>}</div>
<div class="mt-6 flex flex-wrap gap-4 text-sm font-bold"><a asp-controller="Invoices" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Invoices</a><a asp-controller="Cashbook" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Cashbook</a><a asp-controller="FinanceInsights" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Insights →</a></div>
