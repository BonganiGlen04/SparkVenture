@model SparkVenture.ViewModels.RegistrationShareholdersInput

@{
    ViewData["Title"] = "Shareholders";
    Layout = "_DashboardLayout";
}
@await Html.PartialAsync("_WizardHeader", Model)
<div class="mx-auto max-w-4xl rounded-2xl border border-blue-100 bg-white p-5 shadow-sm sm:p-8">
    <form asp-controller="RegistrationApplications" asp-action="SaveShareholders" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ApplicationId" type="hidden" />
        <div asp-validation-summary="All" class="mb-4 text-sm font-medium text-red-700"></div>

        <h2 class="text-lg font-extrabold text-blue-950">Who owns the business?</h2>
        <p class="mt-2 text-sm text-slate-600">List shareholders and their percentages. The total must equal 100% before moving on.</p>
        <div id="shareholderRows" class="mt-5 space-y-4">
            @for (var i = 0; i < Model.Shareholders.Count; i++)
            {
                <div data-entry-row class="rounded-xl border border-blue-100 bg-blue-50/50 p-4">
                    <input asp-for="Shareholders[i].Id" type="hidden" />
                    <div class="grid gap-3 sm:grid-cols-3">
                        <div class="sm:col-span-2"><label class="block text-sm font-bold text-blue-950">Shareholder name</label>
                            <input asp-for="Shareholders[i].DisplayName" maxlength="150" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                        <div><label class="block text-sm font-bold text-blue-950">Owner type</label>
                            <select asp-for="Shareholders[i].ShareholderType" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm">
                                <option value="Individual">Individual</option><option value="Company">Company</option>
                            </select></div>
                        <div class="sm:col-span-2"><label class="block text-sm font-bold text-blue-950">Ownership percentage</label>
                            <input asp-for="Shareholders[i].SharePercentage" type="number" min="0.0001" max="100" step="0.0001" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                    </div>
                    <button type="button" data-clear-row class="mt-3 text-xs font-bold text-red-700 hover:underline">Remove this shareholder</button>
                </div>
            }
        </div>
        <button id="addShareholder" type="button" class="mt-4 rounded-xl border border-blue-200 px-4 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50">+ Add shareholder</button>
        <p class="mt-3 text-xs text-slate-500">Up to 10 shareholders. Save draft can store an incomplete total; Save &amp; continue requires exactly 100%.</p>
        <template id="shareholderTemplate">
            <div data-entry-row class="rounded-xl border border-blue-100 bg-blue-50/50 p-4">
                <input name="Shareholders[__INDEX__].Id" type="hidden" value="" />
                <div class="grid gap-3 sm:grid-cols-3">
                    <div class="sm:col-span-2"><label class="block text-sm font-bold text-blue-950">Shareholder name</label>
                        <input name="Shareholders[__INDEX__].DisplayName" maxlength="150" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                    <div><label class="block text-sm font-bold text-blue-950">Owner type</label>
                        <select name="Shareholders[__INDEX__].ShareholderType" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm"><option value="Individual">Individual</option><option value="Company">Company</option></select></div>
                    <div class="sm:col-span-2"><label class="block text-sm font-bold text-blue-950">Ownership percentage</label>
                        <input name="Shareholders[__INDEX__].SharePercentage" type="number" min="0.0001" max="100" step="0.0001" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                </div>
                <button type="button" data-clear-row class="mt-3 text-xs font-bold text-red-700 hover:underline">Remove this shareholder</button>
            </div>
        </template>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-blue-100 pt-5">
            <a asp-action="Step" asp-route-id="@Model.ApplicationId" asp-route-key="directors" class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">← Back</a>
            <div class="flex flex-wrap gap-2">
                <button type="submit" name="continueToNext" value="false"
                    class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">Save draft &amp; exit</button>
                <button type="submit" name="continueToNext" value="true"
                    class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">Save &amp; continue →</button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const list = document.getElementById("shareholderRows");
            const addButton = document.getElementById("addShareholder");
            const template = document.getElementById("shareholderTemplate");
            const prefix = "Shareholders";
            let nextIndex = list.querySelectorAll("[data-entry-row]").length;
            addButton.addEventListener("click", () => {
                if (nextIndex >= 10) return;
                const wrapper = document.createElement("div");
                wrapper.innerHTML = template.innerHTML.replaceAll("__INDEX__", String(nextIndex));
                list.appendChild(wrapper.firstElementChild);
                nextIndex += 1;
                if (nextIndex >= 10) addButton.disabled = true;
            });
            list.addEventListener("click", e => {
                if (!e.target.matches("[data-clear-row]")) return;
                const row = e.target.closest("[data-entry-row]");
                row.querySelectorAll("input").forEach(input => input.value = "");
                row.querySelectorAll("select").forEach(select => select.selectedIndex = 0);
                // Keep the indexed controls in the DOM so ASP.NET Core model binding has no gaps.
                row.hidden = true;
            });
        })();
    </script>
}
