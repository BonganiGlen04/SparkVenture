@model SparkVenture.ViewModels.RegistrationAddressInput

@{
    ViewData["Title"] = "Registered Address";
    Layout = "_DashboardLayout";
}
@await Html.PartialAsync("_WizardHeader", Model)
<div class="mx-auto max-w-4xl rounded-2xl border border-blue-100 bg-white p-5 shadow-sm sm:p-8">
    <form asp-controller="RegistrationApplications" asp-action="SaveAddress" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ApplicationId" type="hidden" />
        <div asp-validation-summary="All" class="mb-4 text-sm font-medium text-red-700"></div>

        <h2 class="text-lg font-extrabold text-blue-950">Registered office address</h2>
        <p class="mt-2 text-sm text-slate-600">Enter the proposed registered-office location for this application.</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2"><label asp-for="AddressLine1" class="block text-sm font-bold text-blue-950">Street address</label>
                <input asp-for="AddressLine1" maxlength="200" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
            <div class="sm:col-span-2"><label asp-for="AddressLine2" class="block text-sm font-bold text-blue-950">Address line 2 (optional)</label>
                <input asp-for="AddressLine2" maxlength="200" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
            <div><label asp-for="City" class="block text-sm font-bold text-blue-950">Town / city</label>
                <input asp-for="City" maxlength="100" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
            <div><label asp-for="PostalCode" class="block text-sm font-bold text-blue-950">Postal code</label>
                <input asp-for="PostalCode" maxlength="12" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
            <div class="sm:col-span-2"><label asp-for="ProvinceId" class="block text-sm font-bold text-blue-950">Province</label>
                <select asp-for="ProvinceId" asp-items="Model.Provinces" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm">
                    <option value="">Choose your province</option>
                </select></div>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-blue-100 pt-5">
            <a asp-action="Step" asp-route-id="@Model.ApplicationId" asp-route-key="shareholders" class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">← Back</a>
            <div class="flex flex-wrap gap-2">
                <button type="submit" name="continueToNext" value="false"
                    class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">Save draft &amp; exit</button>
                <button type="submit" name="continueToNext" value="true"
                    class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">Save &amp; continue →</button>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
