@model SparkVenture.ViewModels.RegistrationNamesInput

@{
    ViewData["Title"] = "Proposed Names";
    Layout = "_DashboardLayout";
}
@await Html.PartialAsync("_WizardHeader", Model)
<div class="mx-auto max-w-4xl rounded-2xl border border-blue-100 bg-white p-5 shadow-sm sm:p-8">
    <form asp-controller="RegistrationApplications" asp-action="SaveNames" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ApplicationId" type="hidden" />
        <div asp-validation-summary="All" class="mb-4 text-sm font-medium text-red-700"></div>

        <h2 class="text-lg font-extrabold text-blue-950">Choose your preferred company names</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Enter up to three distinct names in preference order. These are suggestions, not verified CIPC name availability.</p>
        <div class="mt-5 rounded-xl border border-blue-100 bg-blue-50 p-4">
            <p class="text-sm font-bold text-blue-950">Existing SparkVenture business</p>
            <p class="mt-1 text-sm text-blue-900">Trading name: @Model.TradingName</p>
            @if (!string.IsNullOrWhiteSpace(Model.LegalName))
            { <p class="mt-1 text-xs text-blue-800">Legal name: @Model.LegalName</p> }
            <p class="mt-2 text-xs text-blue-800">To correct these details, return to your business profile before confirming.</p>
        </div>
        <div class="mt-5 space-y-4">
            <div><label asp-for="Name1" class="block text-sm font-bold text-blue-950">First choice</label>
                 <input asp-for="Name1" maxlength="150" autocomplete="off" placeholder="Example: Kasi Kicks (Pty) Ltd" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
            <div><label asp-for="Name2" class="block text-sm font-bold text-blue-950">Second choice (optional)</label>
                 <input asp-for="Name2" maxlength="150" autocomplete="off" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
            <div><label asp-for="Name3" class="block text-sm font-bold text-blue-950">Third choice (optional)</label>
                 <input asp-for="Name3" maxlength="150" autocomplete="off" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
        </div>
        <label class="mt-5 flex items-start gap-3 rounded-xl border border-blue-100 bg-blue-50 p-4 text-sm text-blue-950">
            <input asp-for="ConfirmBusinessDetails" type="checkbox" class="mt-1 h-4 w-4" />
            <span>I have checked the business details above and they belong to the correct business.</span>
        </label>
        <p class="mt-4 text-xs text-slate-500">Save draft works before this section is complete. Save &amp; continue requires at least one name and confirmation.</p>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-blue-100 pt-5">
            <a asp-action="Details" asp-route-id="@Model.ApplicationId" class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">← Back</a>
            <div class="flex flex-wrap gap-2">
                <button type="submit" name="continueToNext" value="false"
                    class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">Save draft &amp; exit</button>
                <button type="submit" name="continueToNext" value="true"
                    class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">Save &amp; continue →</button>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
