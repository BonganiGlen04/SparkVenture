@model SparkVenture.ViewModels.RegistrationDirectorsInput

@{
    ViewData["Title"] = "Directors";
    Layout = "_DashboardLayout";
}
@await Html.PartialAsync("_WizardHeader", Model)
<div class="mx-auto max-w-4xl rounded-2xl border border-blue-100 bg-white p-5 shadow-sm sm:p-8">
    <form asp-controller="RegistrationApplications" asp-action="SaveDirectors" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ApplicationId" type="hidden" />
        <div asp-validation-summary="All" class="mb-4 text-sm font-medium text-red-700"></div>

        <h2 class="text-lg font-extrabold text-blue-950">Company directors</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Add the people who will act as directors. For this MVP we collect names and contact details only; do not enter identity numbers here.</p>
        <div id="directorRows" class="mt-5 space-y-4">
            @for (var i = 0; i < Model.Directors.Count; i++)
            {
                <div data-entry-row class="rounded-xl border border-blue-100 bg-blue-50/50 p-4">
                    <input asp-for="Directors[i].Id" type="hidden" />
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="sm:col-span-2"><label class="block text-sm font-bold text-blue-950">Full name</label>
                            <input asp-for="Directors[i].FullName" maxlength="150" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                        <div><label class="block text-sm font-bold text-blue-950">Email</label>
                            <input asp-for="Directors[i].Email" type="email" maxlength="254" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                        <div><label class="block text-sm font-bold text-blue-950">Contact number</label>
                            <input asp-for="Directors[i].ContactNumber" maxlength="30" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                    </div>
                    <button type="button" data-clear-row class="mt-3 text-xs font-bold text-red-700 hover:underline">Remove this person</button>
                </div>
            }
        </div>
        <button id="addDirector" type="button" class="mt-4 rounded-xl border border-blue-200 px-4 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50">+ Add another director</button>
        <p class="mt-3 text-xs text-slate-500">Up to 10 directors. Only complete rows are saved; enter at least one before continuing.</p>
        <template id="directorTemplate">
            <div data-entry-row class="rounded-xl border border-blue-100 bg-blue-50/50 p-4">
                <input name="Directors[__INDEX__].Id" type="hidden" value="" />
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="sm:col-span-2"><label class="block text-sm font-bold text-blue-950">Full name</label>
                        <input name="Directors[__INDEX__].FullName" maxlength="150" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                    <div><label class="block text-sm font-bold text-blue-950">Email</label>
                        <input name="Directors[__INDEX__].Email" type="email" maxlength="254" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                    <div><label class="block text-sm font-bold text-blue-950">Contact number</label>
                        <input name="Directors[__INDEX__].ContactNumber" maxlength="30" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm" /></div>
                </div>
                <button type="button" data-clear-row class="mt-3 text-xs font-bold text-red-700 hover:underline">Remove this person</button>
            </div>
        </template>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-blue-100 pt-5">
            <a asp-action="Step" asp-route-id="@Model.ApplicationId" asp-route-key="proposed-names" class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">← Back</a>
            <div class="flex flex-wrap gap-2">
                <button type="submit" name="continueToNext" value="false"
                    class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">Save draft &amp; exit</button>
                <button type="submit" name="continueToNext" value="true"
                    class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">Save &amp; continue →</button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const list = document.getElementById("directorRows");
            const addButton = document.getElementById("addDirector");
            const template = document.getElementById("directorTemplate");
            const prefix = "Directors";
            let nextIndex = list.querySelectorAll("[data-entry-row]").length;
            addButton.addEventListener("click", () => {
                if (nextIndex >= 10) return;
                const wrapper = document.createElement("div");
                wrapper.innerHTML = template.innerHTML.replaceAll("__INDEX__", String(nextIndex));
                list.appendChild(wrapper.firstElementChild);
                nextIndex += 1;
                if (nextIndex >= 10) addButton.disabled = true;
            });
            list.addEventListener("click", e => {
                if (!e.target.matches("[data-clear-row]")) return;
                const row = e.target.closest("[data-entry-row]");
                row.querySelectorAll("input").forEach(input => input.value = "");
                row.querySelectorAll("select").forEach(select => select.selectedIndex = 0);
                // Keep the indexed controls in the DOM so ASP.NET Core model binding has no gaps.
                row.hidden = true;
            });
        })();
    </script>
}
