@model SparkVenture.ViewModels.RegistrationWizardPageViewModel
@{
    var steps = new[]
    {
        (Key: "proposed-names", Label: "Names"),
        (Key: "directors", Label: "Directors"),
        (Key: "shareholders", Label: "Shareholders"),
        (Key: "addresses", Label: "Address"),
        (Key: "year-end", Label: "Year-end"),
        (Key: "review", Label: "Review")
    };
    var progress = (int)Math.Round((Model.StepNumber - 1) / 5.0 * 100.0);
}
<div class="mb-7">
    <a asp-controller="RegistrationApplications" asp-action="Details" asp-route-id="@Model.ApplicationId"
       class="text-sm font-semibold text-blue-600 hover:text-blue-800">← Registration checklist</a>
    <p class="mt-5 text-xs font-bold uppercase tracking-widest text-blue-600">Phase B2 · Company registration preparation</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-blue-950">@Model.StepTitle</h1>
    <p class="mt-2 text-sm text-slate-600">@Model.BusinessName · Step @Model.StepNumber of 6 · Saved to your registration draft</p>
</div>
<div class="mb-6 rounded-2xl border border-blue-100 bg-white p-4 shadow-sm sm:p-5">
    <div class="flex items-center justify-between text-xs font-semibold text-blue-900">
        <span>Registration details</span><span>Step @Model.StepNumber / 6</span>
    </div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-blue-100">
        <div class="h-2 rounded-full bg-blue-600" style="width: @(progress)%"></div>
    </div>
    <nav aria-label="Wizard steps" class="mt-4 grid grid-cols-3 gap-2 text-xs sm:grid-cols-6">
        @for (var i = 0; i < steps.Length; i++)
        {
            var step = steps[i];
            var active = Model.StepNumber == i + 1;
            if (step.Key == "review")
            {
                <a asp-action="Summary" asp-route-id="@Model.ApplicationId"
                   class="rounded-lg px-2 py-2 text-center font-semibold @(active ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-800 hover:bg-blue-100")">
                    @(i + 1). @step.Label
                </a>
            }
            else
            {
                <a asp-action="Step" asp-route-id="@Model.ApplicationId" asp-route-key="@step.Key"
                   class="rounded-lg px-2 py-2 text-center font-semibold @(active ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-800 hover:bg-blue-100")">
                    @(i + 1). @step.Label
                </a>
            }
        }
    </nav>
</div>
