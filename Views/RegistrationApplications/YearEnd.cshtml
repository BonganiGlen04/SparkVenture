@model SparkVenture.ViewModels.RegistrationYearEndInput

@{
    ViewData["Title"] = "Financial Year-End";
    Layout = "_DashboardLayout";
}
@await Html.PartialAsync("_WizardHeader", Model)
<div class="mx-auto max-w-4xl rounded-2xl border border-blue-100 bg-white p-5 shadow-sm sm:p-8">
    <form asp-controller="RegistrationApplications" asp-action="SaveYearEnd" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ApplicationId" type="hidden" />
        <div asp-validation-summary="All" class="mb-4 text-sm font-medium text-red-700"></div>

        <h2 class="text-lg font-extrabold text-blue-950">Choose your financial year-end</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Select the month when your company's financial year will end. This is a preparation detail; confirm the correct choice during official filing or with a qualified adviser.</p>
        <div class="mt-5">
            <label asp-for="YearEndMonth" class="block text-sm font-bold text-blue-950">Financial year-end month</label>
            <select asp-for="YearEndMonth" class="mt-1 w-full rounded-xl border border-blue-200 px-4 py-3 text-sm">
                <option value="">Select a month</option>
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month">@(System.Globalization.CultureInfo.GetCultureInfo("en-ZA").DateTimeFormat.GetMonthName(month))</option>
                }
            </select>
        </div>
        <p class="mt-4 text-xs text-slate-500">You can save and return later, or continue to the review page once a month has been selected.</p>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-blue-100 pt-5">
            <a asp-action="Step" asp-route-id="@Model.ApplicationId" asp-route-key="addresses" class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">← Back</a>
            <div class="flex flex-wrap gap-2">
                <button type="submit" name="continueToNext" value="false"
                    class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 hover:bg-blue-50">Save draft &amp; exit</button>
                <button type="submit" name="continueToNext" value="true"
                    class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">Save &amp; continue →</button>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
