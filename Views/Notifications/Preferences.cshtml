@model SparkVenture.ViewModels.NotificationPreferencesViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Notification Preferences";
}
<div class="mb-8">
    <a asp-action="Index" class="text-sm font-bold text-blue-600 hover:text-blue-800">← Back to notifications</a>
    <h1 class="mt-5 text-3xl font-extrabold text-blue-950">Notification preferences</h1>
    <p class="mt-2 text-sm text-slate-600">Control which categories and channels you want enabled.</p>
</div>
@if (TempData["SuccessMessage"] is string message)
{
    <p class="mb-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-800">@message</p>
}
<div class="max-w-3xl rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">
    @if (Model.Items.Count == 0)
    {
        <p class="text-sm text-slate-600">No notification preferences have been configured for your account yet.</p>
    }
    else
    {
        <form asp-action="Preferences" method="post">
            @Html.AntiForgeryToken()
            <div class="divide-y divide-blue-100">
                @foreach (var row in Model.Items)
                {
                    <label class="flex items-center justify-between gap-4 py-4">
                        <span>
                            <span class="block text-sm font-bold text-blue-950">@row.Category</span>
                            <span class="mt-1 block text-xs text-slate-500">@row.Channel</span>
                        </span>
                        <input type="checkbox" name="enabledIds" value="@row.NotificationPreferenceId"
                               checked="@row.IsEnabled" class="h-5 w-5 rounded border-blue-200 text-blue-600 focus:ring-blue-500" />
                    </label>
                }
            </div>
            <button type="submit" class="mt-6 rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white hover:bg-blue-700">Save preferences</button>
        </form>
    }
</div>
