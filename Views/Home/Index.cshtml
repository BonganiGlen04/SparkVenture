@{
    ViewData["Title"] = "Home";
    
}

<!-- NAVBAR -->
<header class="sticky top-0 z-50 border-b border-blue-100 bg-white/95 backdrop-blur">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 lg:px-8">
        <a asp-controller="Home" asp-action="Index" class="shrink-0">
            <img src="~/images/nav-logo.png"
                 alt="SparkVenture"
                 class="h-10 w-auto object-contain" />
        </a>

        <div class="hidden items-center gap-7 text-sm font-semibold text-blue-950 md:flex">
            <a href="#home" class="hover:text-blue-600">Home</a>
            <a href="#features" class="hover:text-blue-600">Features</a>
            <a href="#pricing" class="hover:text-blue-600">Pricing</a>
            <a href="#resources" class="hover:text-blue-600">Resources</a>
            <a href="#about" class="hover:text-blue-600">About</a>
        </div>

        <div class="hidden items-center gap-3 sm:flex">
            <a asp-area="Identity" asp-page="/Account/Login"
               class="rounded-xl border border-blue-600 px-5 py-2.5 text-sm font-semibold text-blue-600 hover:bg-blue-50">
                Sign in
            </a>
            <a asp-area="Identity" asp-page="/Account/Register"
               class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
                Get started
            </a>
        </div>

        <button id="menuButton"
                type="button"
                aria-label="Toggle navigation"
                aria-expanded="false"
                aria-controls="mobileMenu"
                class="rounded-lg p-2 text-blue-950 hover:bg-blue-50 md:hidden">
            <svg class="h-6 w-6" fill="none" stroke="currentColor"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                      stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </nav>

    <div id="mobileMenu" class="hidden border-t border-blue-100 bg-white px-5 py-5 md:hidden">
        <div class="flex flex-col gap-4 text-sm font-semibold text-blue-950">
            <a href="#home">Home</a>
            <a href="#features">Features</a>
            <a href="#pricing">Pricing</a>
            <a href="#resources">Resources</a>
            <a href="#about">About</a>
            <a asp-area="Identity" asp-page="/Account/Login">Sign in</a>
            <a asp-area="Identity" asp-page="/Account/Register"
               class="rounded-xl bg-blue-600 px-4 py-3 text-center text-white">
                Get started
            </a>
        </div>
    </div>
</header>

<main>
    <!-- HERO -->
    <section id="home" class="bg-gradient-to-br overflow-hidden from-blue-50 via-white to-sky-100">
        <div class="mx-auto grid max-w-7xl items-center gap-12 px-2 py-16 lg:grid-cols-2 lg:px-8 lg:py-20">
            <div>
                <p class="text-xs font-bold tracking-[0.18em] text-blue-600 uppercase">
                    Supporting South Africa's entrepreneurs
                </p>

                <h1 class="mt-5 text-4xl leading-tight font-extrabold tracking-tight text-blue-950 sm:text-5xl lg:text-6xl">
                    Turn your business idea into your next
                    <span class="text-blue-500">big move.</span>
                </h1>

                <p class="mt-6 max-w-xl leading-7 text-slate-600 sm:text-lg">
                    Practical tools, trusted opportunities and step-by-step
                    guidance to start, manage and grow your business in South Africa.
                </p>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a asp-area="Identity" asp-page="/Account/Register"
                       class="rounded-xl bg-blue-600 px-6 py-4 text-center font-bold text-white shadow-lg shadow-blue-200 hover:bg-blue-700">
                        Start your journey →
                    </a>
                    <a href="#features"
                       class="rounded-xl border border-blue-600 bg-white px-6 py-4 text-center font-bold text-blue-600 hover:bg-blue-50">
                        Explore opportunities
                    </a>
                </div>

                <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-4">
                    <div class="text-sm font-semibold text-blue-950">
                        <span class="mb-2 block text-2xl text-blue-600">◈</span>
                        Funding and grants
                    </div>
                    <div class="text-sm font-semibold text-blue-950">
                        <span class="mb-2 block text-2xl text-blue-600">♧</span>
                        Markets and buyers
                    </div>
                    <div class="text-sm font-semibold text-blue-950">
                        <span class="mb-2 block text-2xl text-blue-600">↗</span>
                        Business finances
                    </div>
                    <div class="text-sm font-semibold text-blue-950">
                        <span class="mb-2 block text-2xl text-blue-600">✓</span>
                        Compliance and security
                    </div>
                </div>
            </div>

            <!-- Replace with your own entrepreneur image -->
            <div class="relative w-full">
                <img src="~/images/dashboard.png"
                     alt="Entrepreneur"
                     class="h-[500px] w-full rounded-3xl object-cover shadow-2xl sm:h-[500px]" />

                @* <div class="absolute right-3 -bottom-5 left-3 rounded-2xl border border-blue-100 bg-white p-5 shadow-xl sm:right-12 sm:-left-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-500">Business readiness</p>
                            <h2 class="mt-1 font-bold text-blue-950">Your business overview</h2>
                        </div>
                        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700">
                            On track
                        </span>
                    </div>

                    <div class="mt-5 flex items-center gap-4">
                        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-4 border-emerald-400 text-lg font-extrabold text-blue-950">
                            70%
                        </div>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-blue-950">Business progress</p>
                            <div class="mt-3 h-2 rounded-full bg-slate-100">
                                <div class="h-2 w-[70%] rounded-full bg-blue-600"></div>
                            </div>
                            <p class="mt-2 text-xs text-slate-500">Keep completing your profile.</p>
                        </div>
                    </div> *@
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="px-5 py-20 lg:px-8">
        <div class="mx-auto max-w-7xl">
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-bold tracking-widest text-blue-600 uppercase">Everything you need</p>
                <h2 class="mt-3 text-3xl font-extrabold text-blue-950 sm:text-4xl">
                    Built for South African entrepreneurs
                </h2>
                <p class="mt-4 leading-7 text-slate-600">
                    From idea to impact, get the tools and resources to build a sustainable business.
                </p>
            </div>

            <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                @{
                    var features = new[]
                    {
                                new { Icon = "🚀", Name = "Business Registration", Description = "Guidance to formalise your business and find CIPC resources." },
                                new { Icon = "📘", Name = "Bookkeeping & Finance", Description = "Track income, expenses and invoices in one place." },
                                new { Icon = "🔎", Name = "Procurement Access", Description = "Discover tenders, RFQs and supplier opportunities." },
                                new { Icon = "🏪", Name = "Market Links", Description = "Find customers, markets and new sales channels." },
                                new { Icon = "💰", Name = "Funding Readiness", Description = "Prepare your business to explore funding opportunities." },
                                new { Icon = "🛡️", Name = "Fraud Protection", Description = "Learn to recognise scams and protect business data." },
                                new { Icon = "🔔", Name = "Reminders & Compliance", Description = "Keep track of deadlines and business obligations." },
                                new { Icon = "👥", Name = "Support & Resources", Description = "Explore learning materials and business support." }
                                };
                }

                @foreach (var feature in features)
                {
                    <article class="rounded-2xl border border-blue-100 bg-white p-6 transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-2xl">
                            @feature.Icon
                        </div>
                        <h3 class="mt-5 text-lg font-bold text-blue-950">@feature.Name</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@feature.Description</p>
                        <a href="#resources" class="mt-5 inline-block text-sm font-bold text-blue-600 hover:text-blue-800">
                            Learn more →
                        </a>
                    </article>
                }
            </div>
        </div>
    </section>

    <!-- ABOUT AND TESTIMONIALS -->
    <section id="about" class="bg-gradient-to-br from-blue-50 to-sky-100 px-5 py-20 lg:px-8">
        <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-3">
            <div>
                <p class="text-xs font-bold tracking-widest text-blue-600 uppercase">Real people. Real impact.</p>
                <h2 class="mt-3 text-3xl font-extrabold text-blue-950">
                    Helping entrepreneurs move forward
                </h2>
                <p class="mt-5 leading-7 text-slate-600">
                    Find useful resources, discover opportunities and take practical steps towards growing your business.
                </p>
                <a asp-area="Identity" asp-page="/Account/Register"
                   class="mt-7 inline-block rounded-xl bg-blue-600 px-5 py-3 font-bold text-white hover:bg-blue-700">
                    Join our community →
                </a>
            </div>

            <div class="grid gap-5 sm:grid-cols-2 lg:col-span-2">
                <article class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
                    <div class="text-amber-400" aria-label="5 out of 5 stars">★★★★★</div>
                    <p class="mt-4 leading-7 text-slate-600">
                        "Having business resources in one place makes planning my next steps easier."
                    </p>
                    <p class="mt-5 font-bold text-blue-950">Small business owner</p>
                    <p class="text-sm text-slate-500">South Africa</p>
                </article>

                <article class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
                    <div class="text-amber-400" aria-label="5 out of 5 stars">★★★★★</div>
                    <p class="mt-4 leading-7 text-slate-600">
                        "Finding relevant opportunities and guidance helps me plan for growth."
                    </p>
                    <p class="mt-5 font-bold text-blue-950">Emerging entrepreneur</p>
                    <p class="text-sm text-slate-500">South Africa</p>
                </article>
            </div>
        </div>
    </section>

    <!-- RESOURCES -->
    <section id="resources" class="px-5 py-16 lg:px-8">
        <div class="mx-auto flex max-w-7xl flex-col justify-between gap-6 rounded-3xl bg-blue-50 p-8 sm:p-12 md:flex-row md:items-center">
            <div class="max-w-2xl">
                <h2 class="text-3xl font-extrabold text-blue-950">Resources to help your business grow</h2>
                <p class="mt-4 leading-7 text-slate-600">
                    Explore registration guidance, funding information, procurement and business learning resources.
                </p>
            </div>
            <a href="#features" class="shrink-0 rounded-xl bg-blue-600 px-6 py-4 text-center font-bold text-white hover:bg-blue-700">
                Explore resources →
            </a>
        </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 px-5 py-20 text-white lg:px-8">
        <div class="mx-auto max-w-7xl">
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-bold tracking-widest text-sky-300 uppercase">Simple, transparent pricing</p>
                <h2 class="mt-4 text-3xl font-extrabold sm:text-5xl">
                    Choose the right plan for your business
                    <span class="text-sky-300">journey</span>
                </h2>
                <p class="mt-5 leading-7 text-blue-100">Start for free and upgrade as you grow.</p>
            </div>

            <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
                @{
                    var plans = new[]
                    {
                                new { Name = "Free", Price = "R0", Description = "For idea-stage founders and small businesses.", Highlight = false, Items = new[] { "Business profile", "Basic bookkeeping", "Public opportunities", "Basic support" } },
                                new { Name = "Starter", Price = "R199", Description = "For growing businesses ready for the next step.", Highlight = true, Items = new[] { "Everything in Free", "Invoice tracking", "Tender alerts", "Funding readiness", "Email support" } },
                                new { Name = "Business", Price = "R499", Description = "For established businesses and teams.", Highlight = false, Items = new[] { "Everything in Starter", "Multi-user access", "Advanced reports", "Priority support", "Custom notifications" } },
                                new { Name = "Enterprise", Price = "Custom", Description = "For larger businesses and support organisations.", Highlight = false, Items = new[] { "Everything in Business", "Unlimited users", "Account management", "Advanced integrations", "Custom branding" } }
                                };
                }

                @foreach (var plan in plans)
                {
                    <article class="relative flex flex-col rounded-2xl border bg-white p-6 text-slate-700 shadow-xl @(plan.Highlight ? "border-sky-400 ring-2 ring-sky-400 xl:-translate-y-2" : "border-blue-100")">
                        @if (plan.Highlight)
                        {
                            <span class="mb-3 w-fit rounded-full bg-sky-100 px-3 py-1 text-xs font-extrabold text-blue-800">
                                MOST POPULAR
                            </span>
                        }

                        <h3 class="text-xl font-extrabold text-blue-950">@plan.Name</h3>
                        <p class="mt-3 min-h-12 text-sm leading-6 text-slate-500">@plan.Description</p>

                        <p class="mt-5 text-4xl font-extrabold text-blue-950">@plan.Price</p>
                        @if (plan.Price != "Custom")
                        {
                            <p class="mt-1 text-sm text-slate-500">per month</p>
                        }

                        <a asp-area="Identity" asp-page="/Account/Register"
                           class="mt-6 rounded-xl px-4 py-3 text-center text-sm font-bold @(plan.Highlight ? "bg-blue-600 text-white hover:bg-blue-700" : "border border-blue-600 text-blue-600 hover:bg-blue-50")">
                            @(plan.Price == "Custom" ? "Contact sales" : "Get started")
                        </a>

                        <ul class="mt-7 flex-1 space-y-3 text-sm">
                            @foreach (var item in plan.Items)
                            {
                                <li class="flex gap-2">
                                    <span class="font-bold text-blue-600">✓</span>
                                    <span>@item</span>
                                </li>
                            }
                        </ul>
                    </article>
                }
            </div>

            <p class="mt-6 text-center text-xs text-blue-200">
                Illustrative pricing. Update these plans to match your actual services.
            </p>
        </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="px-5 py-20 lg:px-8">
        <div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-2">
            <div>
                <p class="text-xs font-bold tracking-widest text-blue-600 uppercase">Frequently asked questions</p>
                <h2 class="mt-3 text-3xl font-extrabold text-blue-950">Questions? We've got answers.</h2>

                <div class="mt-8 space-y-3">
                    <details class="group rounded-xl border border-blue-100 p-5">
                        <summary class="flex cursor-pointer list-none justify-between gap-4 font-bold text-blue-950">
                            Can I change my plan later?
                            <span class="text-blue-600">+</span>
                        </summary>
                        <p class="mt-4 text-sm leading-6 text-slate-600">
                            Plan changes can be supported through your subscription management system.
                        </p>
                    </details>

                    <details class="group rounded-xl border border-blue-100 p-5">
                        <summary class="flex cursor-pointer list-none justify-between gap-4 font-bold text-blue-950">
                            Is there a free plan?
                            <span class="text-blue-600">+</span>
                        </summary>
                        <p class="mt-4 text-sm leading-6 text-slate-600">
                            The proposed Free plan helps new entrepreneurs explore the platform.
                        </p>
                    </details>

                    <details class="group rounded-xl border border-blue-100 p-5">
                        <summary class="flex cursor-pointer list-none justify-between gap-4 font-bold text-blue-950">
                            What payment methods do you accept?
                            <span class="text-blue-600">+</span>
                        </summary>
                        <p class="mt-4 text-sm leading-6 text-slate-600">
                            Add the payment methods supported by your payment provider.
                        </p>
                    </details>

                    <details class="group rounded-xl border border-blue-100 p-5">
                        <summary class="flex cursor-pointer list-none justify-between gap-4 font-bold text-blue-950">
                            Is my business data secure?
                            <span class="text-blue-600">+</span>
                        </summary>
                        <p class="mt-4 text-sm leading-6 text-slate-600">
                            Review our privacy practices and the security measures implemented by the platform.
                        </p>
                    </details>
                </div>
            </div>

            <div class="bg-gradient-to-br rounded-3xl from-blue-50 to-sky-100 p-8 sm:p-12">
                <span class="text-4xl text-blue-600">✦</span>
                <h3 class="mt-5 text-3xl font-extrabold text-blue-950">
                    Real tools. Local support. Lasting impact.
                </h3>
                <p class="mt-4 leading-7 text-slate-600">
                    Take the next step towards building a stronger business with SparkVenture.
                </p>
                <a asp-area="Identity" asp-page="/Account/Register"
                   class="mt-7 inline-block rounded-xl bg-blue-600 px-6 py-3 font-bold text-white hover:bg-blue-700">
                    Get started for free →
                </a>
            </div>
        </div>
    </section>
</main>

<!-- FOOTER -->
<footer class="bg-blue-950 px-5 py-12 text-blue-100 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <div>
            <img src="~/images/footer-logo.png"
                 alt="SparkVenture"
                 class="h-10 w-auto object-contain" />
            <p class="mt-4 max-w-xs text-sm leading-6 text-blue-200">
                Build. Grow. Thrive. Supporting South African entrepreneurs.
            </p>
        </div>

        <div>
            <h3 class="font-bold text-white">Quick links</h3>
            <ul class="mt-4 space-y-3 text-sm">
                <li><a href="#home" class="hover:text-sky-300">Home</a></li>
                <li><a href="#features" class="hover:text-sky-300">Features</a></li>
                <li><a href="#pricing" class="hover:text-sky-300">Pricing</a></li>
                <li><a href="#about" class="hover:text-sky-300">About</a></li>
            </ul>
        </div>

        <div>
            <h3 class="font-bold text-white">Resources</h3>
            <ul class="mt-4 space-y-3 text-sm">
                <li><a href="#resources" class="hover:text-sky-300">Business guides</a></li>
                <li><a href="#resources" class="hover:text-sky-300">Funding opportunities</a></li>
                <li><a href="#faq" class="hover:text-sky-300">Help and support</a></li>
                <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-sky-300">Privacy policy</a></li>
            </ul>
        </div>

        <div>
            <h3 class="font-bold text-white">Get in touch</h3>
            <p class="mt-4 text-sm leading-6 text-blue-200">
                Have questions about growing your business?
            </p>
            <a href="mailto:hello@sparkventure.co.za"
               class="mt-4 inline-block font-semibold text-sky-300 hover:text-white">
                Contact our team →
            </a>
        </div>
    </div>

    <div class="mx-auto mt-10 flex max-w-7xl flex-col gap-3 border-t border-blue-800 pt-6 text-xs text-blue-300 sm:flex-row sm:justify-between">
        <p>© @DateTime.Now.Year SparkVenture. All rights reserved.</p>
        <a asp-controller="Home" asp-action="Privacy" class="hover:text-white">Privacy Policy</a>
    </div>
</footer>

@section Scripts {
    <script>
        const menuButton = document.getElementById("menuButton");
        const mobileMenu = document.getElementById("mobileMenu");

        menuButton?.addEventListener("click", () => {
            const expanded = menuButton.getAttribute("aria-expanded") === "true";

            menuButton.setAttribute("aria-expanded", String(!expanded));
            mobileMenu?.classList.toggle("hidden", expanded);
        });

        mobileMenu?.querySelectorAll("a").forEach(link => {
            link.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
                menuButton?.setAttribute("aria-expanded", "false");
            });
        });
    </script>
}
