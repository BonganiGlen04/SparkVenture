@model SparkVenture.ViewModels.AdminSectorsVm
@{ ViewData["Title"]="Sectors"; Layout="_AdminLayout"; }
<a asp-controller="Admin" asp-action="Index" class="text-sm font-bold text-blue-700">← Administration</a>
<h1 class="mt-4 text-3xl font-extrabold text-blue-950">Business sectors</h1>
<p class="mt-2 mb-6 text-sm text-slate-600">Edit sector labels, not stable codes. These values are shared by businesses and opportunity matching.</p>
@if (TempData["SuccessMessage"] is string message) { <p role="status" class="mb-4 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">@message</p> }
<div class="grid gap-4 lg:grid-cols-2">
@foreach (var row in Model.Rows) {
<form asp-action="SaveSector" method="post" class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
 @Html.AntiForgeryToken()<input type="hidden" name="Id" value="@row.Id" />
 <p class="text-xs font-bold uppercase tracking-widest text-blue-700">@row.Code</p>
 <label class="mt-3 block text-xs font-bold text-slate-600">Sector name<input name="Name" required maxlength="100" value="@row.Name" class="mt-1 w-full rounded-xl border border-blue-200 px-3 py-2 text-sm" /></label>
 <label class="mt-3 block text-xs font-bold text-slate-600">Description<input name="Description" maxlength="200" value="@row.Description" class="mt-1 w-full rounded-xl border border-blue-200 px-3 py-2 text-sm" /></label>
 <button class="mt-4 rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white">Save sector</button>
</form>
}
</div>
