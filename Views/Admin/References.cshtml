@model SparkVenture.ViewModels.AdminReferencesVm
@{ ViewData["Title"]="Reference values"; Layout="_AdminLayout"; }
<a asp-controller="Admin" asp-action="Index" class="text-sm font-bold text-blue-700">← Administration</a>
<h1 class="mt-4 text-3xl font-extrabold text-blue-950">Reference values</h1>
<p class="mt-2 text-sm text-slate-600">Edit the label, description and display order. Codes and categories remain unchanged to protect business references.</p>
@if (TempData["SuccessMessage"] is string message) { <p role="status" class="mt-4 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">@message</p> }
<form asp-action="References" method="get" class="my-6 flex flex-wrap gap-3">
 <select name="category" class="rounded-xl border border-blue-200 bg-white px-4 py-3 text-sm">
 <option value="">All categories</option>
 @foreach (var category in Model.Categories) { <option value="@category" selected="@(Model.Category==category)">@category</option> }
 </select>
 <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white" type="submit">Filter</button>
</form>
<div class="grid gap-4 lg:grid-cols-2">
@foreach(var entry in Model.Rows) {
 <form asp-action="SaveReference" method="post" class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
   @Html.AntiForgeryToken()
   <input type="hidden" name="Id" value="@entry.Id" />
   <div class="flex flex-wrap items-center gap-2"><h2 class="font-bold text-blue-950">@entry.Category / @entry.Code</h2><span class="rounded-full bg-blue-50 px-2 py-1 text-xs text-blue-700">@(entry.IsActive?"Active":"Inactive")</span></div>
   <label class="mt-4 block text-xs font-bold text-slate-600">Display name<input required maxlength="100" name="Name" value="@entry.Name" class="mt-1 block w-full rounded-xl border border-blue-200 px-3 py-2 text-sm" /></label>
   <label class="mt-3 block text-xs font-bold text-slate-600">Description<input maxlength="400" name="Description" value="@entry.Description" class="mt-1 block w-full rounded-xl border border-blue-200 px-3 py-2 text-sm" /></label>
   <label class="mt-3 block text-xs font-bold text-slate-600">Display order<input type="number" min="0" max="10000" name="SortOrder" value="@entry.SortOrder" class="mt-1 block w-32 rounded-xl border border-blue-200 px-3 py-2 text-sm" /></label>
   <button type="submit" class="mt-4 rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700">Save changes</button>
 </form>
}
@if (Model.Rows.Count==0) { <p class="text-slate-500">No reference values found.</p> }
</div>
