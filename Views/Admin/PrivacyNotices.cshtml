@model SparkVenture.ViewModels.AdminNoticesVm
@{ ViewData["Title"]="Privacy notice publishing"; Layout="_AdminLayout"; }
<a asp-action="Index" class="text-sm font-bold text-blue-700">← Administration</a>
<h1 class="mt-4 text-3xl font-extrabold text-blue-950">Published privacy notices</h1>
<div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">Your seed contains <strong>Dummy privacy notice</strong> text. Before deploying publicly, publish a real notice reviewed by the responsible person/legal adviser. This interface does not establish POPIA compliance by itself.</div>
@if (TempData["SuccessMessage"] is string message) { <p role="status" class="mt-4 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">@message</p> }
<div class="mt-6 grid gap-5 lg:grid-cols-3">
 <section class="rounded-2xl border border-blue-100 bg-white p-6 lg:col-span-2">
  <h2 class="text-lg font-bold text-blue-950">Publish reviewed text</h2>
  <form asp-action="PublishNotice" method="post" class="mt-4 space-y-4" onsubmit="return confirm('Publish this notice publicly as a new version?');">
   @Html.AntiForgeryToken()
   <label class="block text-sm font-semibold text-slate-700">Version label<input name="VersionLabel" required maxlength="30" pattern="[A-Za-z0-9._-]{2,30}" placeholder="v1.2" class="mt-1 block w-full rounded-xl border border-blue-200 p-3" /></label>
   <label class="block text-sm font-semibold text-slate-700">Full reviewed notice<textarea name="ContentText" required minlength="200" maxlength="30000" rows="15" class="mt-1 block w-full rounded-xl border border-blue-200 p-3" placeholder="Paste only text that has been approved for publication..."></textarea></label>
   <button type="submit" class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white">Publish new version</button>
  </form>
 </section>
 <aside class="rounded-2xl border border-blue-100 bg-white p-6">
  <h2 class="text-lg font-bold text-blue-950">Version history</h2>
  <ul class="mt-4 space-y-3 text-sm">
  @foreach (var row in Model.History) { <li class="border-b border-blue-50 pb-2"><strong>@row.VersionLabel</strong><span class="block text-slate-500">@row.PublishedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</span></li> }
  </ul>
  <a asp-controller="Privacy" asp-action="Notice" class="mt-4 inline-block text-sm font-bold text-blue-700">Preview public notice →</a>
 </aside>
</div>
