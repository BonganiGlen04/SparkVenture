@model SparkVenture.ViewModels.TenderApplicationsIndexVm
@{
    ViewData["Title"] = "Tender Applications";
    Layout = "_DashboardLayout";
}
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div><p class="text-xs font-extrabold uppercase tracking-widest text-blue-600">Procurement workflow</p>
        <h1 class="mt-1 text-3xl font-extrabold text-blue-950">Tender preparation</h1>
        <p class="mt-2 text-sm text-slate-600">@Model.BusinessName · Local preparation and founder-reported tracking</p></div>
    <a asp-controller="Opportunities" asp-action="Index" asp-route-businessId="@Model.BusinessId" asp-route-type="Tender" class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white">Browse tenders</a>
</div>
<div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">SparkVenture does not file tenders for you. Submit using the original publisher's official instructions. Status changes in this app are self-reported.</div>
<div class="space-y-3">
    @foreach (var item in Model.Items)
    {
        <article class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
            <div><h2 class="font-bold text-blue-950">@item.Title</h2>
                <p class="mt-1 text-xs text-slate-500">@item.Status · Deadline @(item.DeadlineUtc?.ToString("dd MMM yyyy HH:mm") ?? "not specified") UTC</p></div>
            <a asp-action="Details" asp-route-businessId="@Model.BusinessId" asp-route-id="@item.TenderApplicationId" class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white">Open preparation →</a>
        </article>
    }
    @if (Model.Items.Count == 0) { <div class="rounded-2xl border border-blue-100 bg-white p-10 text-center text-slate-600">No tender preparations yet. Select an open Tender opportunity and choose Prepare tender response.</div> }
</div>
