@model SparkVenture.ViewModels.OpportunityDetailsVm
@{
    ViewData["Title"] = "Opportunity Details";
    Layout = "_DashboardLayout";
    var item = Model.Opportunity;
}
<a asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-sm font-bold text-blue-600">← Back to opportunities</a>
<div class="mt-5 rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap gap-2 text-xs font-bold">
        <span class="rounded-full bg-blue-50 px-3 py-1 text-blue-700">@item.Type</span>
        <span class="rounded-full bg-slate-100 px-3 py-1">@item.Status</span>
        @if (item.IsDemo) { <span class="rounded-full bg-amber-100 px-3 py-1 text-amber-900">Unverified demo opportunity</span> }
    </div>
    <h1 class="mt-3 text-3xl font-extrabold text-blue-950">@item.Title</h1>
    <p class="mt-3 whitespace-pre-line text-sm leading-7 text-slate-700">@item.Description</p>
    <p class="mt-4 text-sm text-slate-600">Publisher: <strong>@item.SourceName</strong></p>
    <p class="mt-1 text-sm text-slate-600">Closing: @(item.ClosesAtUtc?.ToString("dd MMM yyyy HH:mm 'UTC'") ?? "Not specified")</p>
    @if (TempData["SuccessMessage"] is string message)
    { <p class="mt-4 rounded-xl bg-green-50 p-3 text-sm text-green-800">@message</p> }
    <div class="mt-5 flex flex-wrap gap-3">
        @if (Model.CanManage && !item.IsSaved)
        {
            <form asp-controller="SavedOpportunities" asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="businessId" value="@Model.BusinessId" />
                <input type="hidden" name="opportunityId" value="@item.OpportunityId" />
                <button type="submit" class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white">Save opportunity</button>
            </form>
        }
        @if (item.IsSaved)
        { <a asp-controller="SavedOpportunities" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="rounded-xl border border-blue-200 px-4 py-2 text-sm font-bold text-blue-700">View saved</a> }
        @if (item.Type == "Tender" && Model.CanManage)
        {
            @if (Model.TenderApplicationId is Guid applicationId)
            { <a asp-controller="TenderApplications" asp-action="Details" asp-route-businessId="@Model.BusinessId" asp-route-id="@applicationId" class="rounded-xl border border-blue-200 px-4 py-2 text-sm font-bold text-blue-700">Open tender preparation</a> }
            else if (item.IsOpen)
            {
                <form asp-controller="TenderApplications" asp-action="Start" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="businessId" value="@Model.BusinessId" />
                    <input type="hidden" name="opportunityId" value="@item.OpportunityId" />
                    <button type="submit" class="rounded-xl bg-blue-950 px-4 py-2 text-sm font-bold text-white">Prepare tender response</button>
                </form>
            }
        }
        @if (SparkVenture.Services.OpportunityQueries.IsValidHttpsUrl(item.SourceWebsite))
        {
            <a href="@item.SourceWebsite" target="_blank" rel="noopener noreferrer" class="rounded-xl border border-blue-200 px-4 py-2 text-sm font-bold text-blue-700">Visit publisher website</a>
        }
    </div>
</div>
<div class="mt-6 rounded-2xl border border-blue-100 bg-white p-6">
    <h2 class="text-lg font-extrabold text-blue-950">Listed requirements</h2>
    <p class="mt-1 text-xs text-slate-500">Verify all requirements with the original publisher. This list may be incomplete or out of date.</p>
    <div class="mt-4 divide-y divide-blue-50">
        @foreach (var rule in Model.Requirements)
        { <div class="flex flex-wrap items-center gap-2 py-3 text-sm"><span class="font-bold text-blue-950">@rule.Type</span><span class="text-slate-600">@rule.Operator @rule.Value</span><span class="ml-auto text-xs text-slate-500">@(rule.IsMandatory ? "Mandatory" : "Optional")</span></div> }
        @if (Model.Requirements.Count == 0) { <p class="py-4 text-sm text-slate-500">No structured requirements are recorded.</p> }
    </div>
</div>
