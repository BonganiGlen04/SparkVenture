@model SparkVenture.ViewModels.AdminBusinessesIndexVm
@{
    ViewData["Title"] = "Business profiles";
    Layout = "_AdminLayout";
    var totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.Total / Model.PageSize));
}
<a asp-controller="Admin" asp-action="Index" class="text-sm font-bold text-blue-700 hover:underline">← Admin dashboard</a>
<h1 class="mt-4 text-3xl font-extrabold text-blue-950">Business profiles</h1>
<p class="mt-2 text-sm text-slate-600">@Model.Total business profile(s) · Administrative overview only</p>
<form method="get" asp-action="Businesses" class="mt-6 flex max-w-lg gap-2">
    <input type="search" name="search" value="@Model.Search" maxlength="100" placeholder="Search business trading name"
           class="min-w-0 flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:border-blue-500" />
    <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">Search</button>
</form>
<div class="mt-6 overflow-x-auto rounded-2xl border border-blue-100 bg-white shadow-sm">
    <table class="min-w-full text-left text-sm">
        <thead class="bg-blue-50 text-blue-950"><tr><th class="p-4">Trading name</th><th class="p-4">Registration number</th><th class="p-4">Active team members</th></tr></thead>
        <tbody class="divide-y divide-blue-50">
            @foreach (var item in Model.Rows)
            {
                <tr>
                    <td class="p-4 font-semibold text-blue-950">@item.TradingName</td>
                    <td class="p-4 text-slate-700">@(string.IsNullOrWhiteSpace(item.RegistrationNumber) ? "Not recorded" : item.RegistrationNumber)</td>
                    <td class="p-4 text-slate-700">@item.ActiveMembers</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="3" class="p-6 text-sm text-slate-500">No matching businesses.</td></tr>
            }
        </tbody>
    </table>
</div>
<div class="mt-5 flex items-center justify-between gap-2 text-sm">
    <span class="text-slate-600">Page @Model.Page of @totalPages</span>
    <div class="flex gap-2">
        @if (Model.Page > 1)
        {
            <a asp-action="Businesses" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)"
               class="rounded-lg border border-blue-200 px-3 py-2 font-semibold text-blue-700">Previous</a>
        }
        @if (Model.Page < totalPages)
        {
            <a asp-action="Businesses" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)"
               class="rounded-lg border border-blue-200 px-3 py-2 font-semibold text-blue-700">Next</a>
        }
    </div>
</div>
