@model SparkVenture.ViewModels.BusinessIndexViewModel
@{
    ViewData["Title"] = "My Businesses";
    Layout = "_DashboardLayout";
}

<!-- PAGE HEADING -->
<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="text-xs font-bold tracking-[0.16em] text-blue-600 uppercase">Business management</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-blue-950 sm:text-4xl">My Businesses</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
            View your business profiles, switch workspaces, and manage business details.
        </p>
    </div>
    <a asp-controller="Businesses" asp-action="CreateBusiness"
       class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 focus:outline-none">
        <span class="text-lg leading-none" aria-hidden="true">+</span> Add Business
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div role="status" class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-800">
        @successMessage
    </div>
}

<!-- SUMMARY -->
<div class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold text-slate-500">Total Businesses</p>
        <p class="mt-2 text-3xl font-extrabold text-blue-950">@Model.TotalBusinesses</p>
        <p class="mt-1 text-xs text-slate-500">Businesses you can access</p>
    </div>
    <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold text-slate-500">Owned Businesses</p>
        <p class="mt-2 text-3xl font-extrabold text-blue-950">@Model.OwnedBusinesses</p>
        <p class="mt-1 text-xs text-slate-500">Businesses where you are an owner</p>
    </div>
    <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold text-slate-500">Team Businesses</p>
        <p class="mt-2 text-3xl font-extrabold text-blue-950">@Model.TeamBusinesses</p>
        <p class="mt-1 text-xs text-slate-500">Businesses shared with you</p>
    </div>
</div>

@if (Model.Businesses.Count == 0)
{
    <!-- EMPTY STATE -->
    <section class="mt-8 rounded-2xl border border-blue-100 bg-white px-6 py-14 text-center shadow-sm">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-blue-100 text-4xl" aria-hidden="true">🏢</div>
        <h2 class="mt-6 text-2xl font-extrabold text-blue-950">You haven't added a business yet</h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-7 text-slate-600">
            Create your first business profile to start keeping records, completing your checklist,
            and discovering opportunities. Your business doesn't have to be CIPC-registered yet.
        </p>
        <a asp-controller="Businesses" asp-action="Create"
           class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3.5 text-sm font-bold text-white hover:bg-blue-700">
            <span aria-hidden="true">+</span> Create My First Business
        </a>
    </section>
}
else
{
    <!-- LIST AND OPTIONAL LOCAL SEARCH -->
    <section class="mt-8" aria-labelledby="business-list-heading">
        <div class="mb-5 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <h2 id="business-list-heading" class="text-lg font-extrabold text-blue-950">Your Business Profiles</h2>
            <label class="block w-full sm:max-w-xs">
                <span class="sr-only">Search your businesses</span>
                <input id="businessSearch" type="search" placeholder="Search businesses..."
                       autocomplete="off"
                       class="w-full rounded-xl border border-blue-100 bg-white px-4 py-3 text-sm text-blue-950 shadow-sm outline-none placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />
            </label>
        </div>

        <div id="businessCards" class="grid gap-5 md:grid-cols-2">
            @foreach (var business in Model.Businesses)
            {
                <article data-business-card
                         data-search="@(business.TradingName + " " + business.Sector + " " + business.Province + " " + business.BusinessStage)"
                         class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm transition hover:border-blue-200 hover:shadow-md">
                    <div class="flex items-start gap-4">
                        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-100 text-xl font-extrabold text-blue-700" aria-hidden="true">
                            @(string.IsNullOrWhiteSpace(business.TradingName) ? "B" : business.TradingName[..1].ToUpperInvariant())
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-lg font-extrabold break-words text-blue-950">@business.TradingName</h3>
                            <p class="mt-1 text-sm text-slate-500">@business.Sector · @business.Province</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@business.BusinessStage</span>
                                <span class="rounded-full px-3 py-1 text-xs font-bold @(business.IsOwner ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-700")">
                                    @business.Role
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 grid grid-cols-2 gap-4 border-t border-blue-50 pt-5">
                        <div>
                            <p class="text-xs font-semibold text-slate-500">Business Type</p>
                            <p class="mt-1 text-sm font-bold text-blue-950">@business.BusinessType</p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-500">Date Added</p>
                            <p class="mt-1 text-sm font-bold text-blue-950">@business.CreatedAtUtc.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>

                    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                        <a asp-controller="Dashboard" asp-action="Index" asp-route-businessId="@business.BusinessId"
                           class="inline-flex flex-1 items-center justify-center rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white transition hover:bg-blue-700">
                            Open Workspace <span class="ml-2" aria-hidden="true">→</span>
                        </a>
                        <a asp-controller="Businesses" asp-action="Details" asp-route-id="@business.BusinessId"
                           class="inline-flex flex-1 items-center justify-center rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700 transition hover:bg-blue-50">
                            View Profile
                        </a>
                    </div>
                    @if (business.CanEdit)
                    {
                        <div class="mt-3 text-right">
                            <a asp-controller="Businesses" asp-action="Edit" asp-route-id="@business.BusinessId"
                               class="text-xs font-bold text-blue-600 hover:text-blue-800 hover:underline">Edit business details</a>
                        </div>
                    }
                </article>
            }
        </div>
        <p id="businessSearchEmpty" class="mt-6 hidden rounded-xl border border-blue-100 bg-white p-8 text-center text-sm text-slate-500">
            No businesses match that search.
        </p>
    </section>
}

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById("businessSearch");
            const cards = [...document.querySelectorAll("[data-business-card]")];
            const noMatches = document.getElementById("businessSearchEmpty");
            if (!search) return;

            search.addEventListener("input", () => {
                const term = search.value.trim().toLocaleLowerCase();
                let shown = 0;
                cards.forEach(card => {
                    const matches = card.dataset.search.toLocaleLowerCase().includes(term);
                    card.classList.toggle("hidden", !matches);
                    if (matches) shown++;
                });
                noMatches?.classList.toggle("hidden", shown !== 0);
            });
        })();
    </script>
}
