@model SparkVenture.ViewModels.CreateBusinessViewModel

@{
    ViewData["Title"] = "Create Business";
    Layout = "_DashboardLayout";

    var inputClass = "mt-2 block w-full rounded-xl border border-blue-100 bg-white px-4 py-3 text-sm text-blue-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100";
    var labelClass = "block text-sm font-bold text-blue-950";
}

<!-- PAGE HEADER -->
<div class="mb-8">
    <a asp-controller="Businesses" asp-action="Index"
       class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-800">
        <span aria-hidden="true">←</span> My Businesses
    </a>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="text-xs font-bold tracking-widest text-blue-600 uppercase">
                Business Onboarding
            </p>
            <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-blue-950 sm:text-4xl">
                Create your business
            </h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">
                Tell us a little about your business so we can help you
                manage your finances, discover opportunities and plan your next steps.
            </p>
        </div>

        <span class="rounded-full bg-blue-100 px-4 py-2 text-xs font-bold text-blue-700">
            Business setup
        </span>
    </div>
</div>

<div class="grid items-start gap-6 xl:grid-cols-3">

    <!-- MAIN FORM -->
    <div class="space-y-6 xl:col-span-2">
        <form asp-controller="Businesses"
              asp-action="CreateBusiness"
              method="post"
              class="space-y-6">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-sm font-semibold text-red-600">
            </div>

            <!-- SECTION 1 -->
            <section class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">

                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-xl font-extrabold text-blue-600">
                        01
                    </div>
                    <div>
                        <h2 class="text-xl font-extrabold text-blue-950">
                            Business Information
                        </h2>
                        <p class="mt-1 text-sm text-slate-500">
                            Let's start with your business identity.
                        </p>
                    </div>
                </div>

                <div class="mt-8 space-y-6">

                    <!-- TRADING NAME -->
                    <div>
                        <label asp-for="TradingName" class="@labelClass">
                            Business / Trading Name <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="TradingName"
                               placeholder="e.g. Kasi Fresh Produce"
                               autocomplete="organization"
                               class="@inputClass" />
                        <p class="mt-2 text-xs text-slate-500">
                            The name your customers know your business by.
                        </p>
                        <span asp-validation-for="TradingName"
                              class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <!-- LEGAL NAME -->
                    <div>
                        <label asp-for="LegalName" class="@labelClass">
                            Registered Legal Name
                            <span class="ml-1 font-normal text-slate-400">(Optional)</span>
                        </label>
                        <input asp-for="LegalName"
                               placeholder="e.g. Kasi Fresh Produce (Pty) Ltd"
                               class="@inputClass" />
                        <p class="mt-2 text-xs text-slate-500">
                            Leave blank if you haven't registered your company yet.
                        </p>
                        <span asp-validation-for="LegalName"
                              class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <!-- REGISTRATION NUMBER -->
                    <div>
                        <label asp-for="RegistrationNumber" class="@labelClass">
                            CIPC Registration Number
                            <span class="ml-1 font-normal text-slate-400">(Optional)</span>
                        </label>
                        <input asp-for="RegistrationNumber"
                               placeholder="e.g. 2026/123456/07"
                               class="@inputClass" />
                        <p class="mt-2 text-xs text-slate-500">
                            If you're not registered, you can add this later.
                        </p>
                        <span asp-validation-for="RegistrationNumber"
                              class="mt-1 block text-xs text-red-600"></span>
                    </div>
                </div>
            </section>

            <!-- SECTION 2 -->
            <section class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">

                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-xl font-extrabold text-blue-600">
                        02
                    </div>
                    <div>
                        <h2 class="text-xl font-extrabold text-blue-950">
                            Business Profile
                        </h2>
                        <p class="mt-1 text-sm text-slate-500">
                            Help us understand what kind of business you're building.
                        </p>
                    </div>
                </div>

                <div class="mt-8 space-y-6">

                    <!-- BUSINESS TYPE -->
                    <div>
                        <label asp-for="BusinessTypeId" class="@labelClass">
                            Business Type <span class="text-red-500">*</span>
                        </label>

                        <select asp-for="BusinessTypeId"
                                asp-items="Model.BusinessTypes"
                                class="@inputClass">
                            <option value="">Select business type</option>
                        </select>

                        <span asp-validation-for="BusinessTypeId"
                              class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <!-- BUSINESS STAGE -->
                    <div>
                        <label asp-for="BusinessStageId" class="@labelClass">
                            Business Stage <span class="text-red-500">*</span>
                        </label>

                        <select asp-for="BusinessStageId"
                                asp-items="Model.BusinessStages"
                                class="@inputClass">
                            <option value="">Where is your business currently?</option>
                        </select>

                        <p class="mt-2 text-xs text-slate-500">
                            Whether it's still an idea or already operating,
                            SparkVenture can help you move forward.
                        </p>

                        <span asp-validation-for="BusinessStageId"
                              class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <!-- SECTOR -->
                    <div>
                        <label asp-for="SectorId" class="@labelClass">
                            Business Sector <span class="text-red-500">*</span>
                        </label>

                        <select asp-for="SectorId"
                                asp-items="Model.Sectors"
                                class="@inputClass">
                            <option value="">Select your industry</option>
                        </select>

                        <p class="mt-2 text-xs text-slate-500">
                            This helps us find relevant tenders, markets and funding opportunities.
                        </p>

                        <span asp-validation-for="SectorId"
                              class="mt-1 block text-xs text-red-600"></span>
                    </div>
                </div>
            </section>

            <!-- SECTION 3 -->
            <section class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">

                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-xl font-extrabold text-blue-600">
                        03
                    </div>
                    <div>
                        <h2 class="text-xl font-extrabold text-blue-950">
                            Business Location
                        </h2>
                        <p class="mt-1 text-sm text-slate-500">
                            Where is your business based?
                        </p>
                    </div>
                </div>

                <div class="mt-8">
                    <label asp-for="ProvinceId" class="@labelClass">
                        Province <span class="text-red-500">*</span>
                    </label>

                    <select asp-for="ProvinceId"
                            asp-items="Model.Provinces"
                            class="@inputClass">
                        <option value="">Select your province</option>
                    </select>

                    <p class="mt-2 text-xs text-slate-500">
                        We'll use your location to recommend relevant local opportunities.
                    </p>

                    <span asp-validation-for="ProvinceId"
                          class="mt-1 block text-xs text-red-600"></span>
                </div>
            </section>

            <!-- FORM ACTIONS -->
            <div class="flex flex-col-reverse gap-3 rounded-2xl border border-blue-100 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
                <a asp-controller="Businesses" asp-action="Index"
                   class="rounded-xl border border-blue-200 px-6 py-3 text-center text-sm font-bold text-blue-700 transition hover:bg-blue-50">
                    Cancel
                </a>

                <button type="submit"
                        class="inline-flex items-center justify-center gap-3 rounded-xl bg-blue-600 px-8 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 focus:outline-none">
                    Create Business
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </form>
    </div>

    <!-- RIGHT SIDEBAR -->
    <aside class="space-y-5 xl:sticky xl:top-24">

        <div class="overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-sm">
            <div class="bg-gradient-to-br from-blue-950 to-blue-700 p-6 text-white">
                <span class="text-3xl">🚀</span>
                <h3 class="mt-4 text-lg font-extrabold">
                    Your business journey starts here
                </h3>
                <p class="mt-3 text-sm leading-6 text-blue-100">
                    One business profile connects you to the tools you need to start,
                    manage and grow.
                </p>
            </div>

            <div class="space-y-5 p-6">
                <div class="flex gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-100 font-bold text-emerald-600">✓</span>
                    <div>
                        <p class="text-sm font-bold text-blue-950">Business Dashboard</p>
                        <p class="mt-1 text-xs leading-5 text-slate-500">
                            Track your progress and important tasks.
                        </p>
                    </div>
                </div>

                <div class="flex gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-lg">📘</span>
                    <div>
                        <p class="text-sm font-bold text-blue-950">Manage Your Finances</p>
                        <p class="mt-1 text-xs leading-5 text-slate-500">
                            Keep records of income, expenses and invoices.
                        </p>
                    </div>
                </div>

                <div class="flex gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-lg">🔎</span>
                    <div>
                        <p class="text-sm font-bold text-blue-950">Discover Opportunities</p>
                        <p class="mt-1 text-xs leading-5 text-slate-500">
                            Explore tenders, markets and funding resources.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-6">
            <div class="flex items-center gap-2">
                <span class="text-xl">🔒</span>
                <h3 class="font-bold text-emerald-900">
                    Your business. Your control.
                </h3>
            </div>

            <p class="mt-3 text-sm leading-6 text-emerald-800">
                Only authorised members of your business should be able
                to access its private records.
            </p>
        </div>

        <div class="rounded-2xl border border-blue-100 bg-blue-50 p-5">
            <p class="text-sm font-bold text-blue-950">
                Don't have a registered company?
            </p>
            <p class="mt-2 text-xs leading-5 text-slate-600">
                That's okay! You can create your SparkVenture business
                profile now and explore formal registration guidance later.
            </p>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
