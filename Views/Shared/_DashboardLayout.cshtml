@using System
@{
    // Set ONLY by ActiveBusinessContextMiddleware after checking active membership.
    Guid? activeBusinessId = ViewContext.HttpContext.Items["SparkVenture.ActiveBusinessId"] is Guid id ? id : null;
    var activeBusinessName = ViewContext.HttpContext.Items["SparkVenture.ActiveBusinessName"] as string;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string dashboardUrl = activeBusinessId.HasValue
        ? (Url.Action("Index", "Dashboard", new { businessId = activeBusinessId.Value }) ?? "/Dashboard")
        : (Url.Action("Index", "Dashboard") ?? "/Dashboard");
    string workspaceUrl = activeBusinessId.HasValue
        ? (Url.Action("Index", "BusinessWorkspace", new { businessId = activeBusinessId.Value }) ?? "/BusinessWorkspace")
        : (Url.Action("Index", "BusinessWorkspace") ?? "/BusinessWorkspace");
    string businessesUrl = Url.Action("Index", "Businesses") ?? "/Businesses";
    string notificationsUrl = Url.Action("Index", "Notifications") ?? "/Notifications";
    string settingsUrl = Url.Page("/Account/Manage/Index", new { area = "Identity" }) ?? "#";
    string initial = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "?" : User.Identity!.Name!.Substring(0, 1).ToUpperInvariant();
    var nav = new[]
    {
        new { Label = "Dashboard", Controller = "Dashboard", Href = dashboardUrl, Icon = "<path d='M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z'/>" },
        new { Label = "My Businesses", Controller = "Businesses", Href = businessesUrl, Icon = "<rect x='4' y='3' width='16' height='18' rx='2'/><path d='M9 8h6M9 12h6M9 16h3'/>" },
        new { Label = "Business Workspace", Controller = "BusinessWorkspace", Href = workspaceUrl, Icon = "<rect x='3' y='3' width='7' height='7' rx='1'/><rect x='14' y='3' width='7' height='7' rx='1'/><rect x='3' y='14' width='7' height='7' rx='1'/><rect x='14' y='14' width='7' height='7' rx='1'/>" },
        new { Label = "Notifications", Controller = "Notifications", Href = notificationsUrl, Icon = "<path d='M6 9a6 6 0 1112 0c0 5 2 6 2 7H4c0-1 2-2 2-7zM10 20a2 2 0 004 0'/>" },
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SparkVenture</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-blue-50 text-slate-700 antialiased">
    <div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-blue-950/40 lg:hidden"></div>

    <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col border-r border-blue-100 bg-white px-4 py-6 transition-transform duration-200 lg:translate-x-0" aria-label="Main navigation">
        <a href="@dashboardUrl" class="mb-7 block px-3">
            <img src="~/images/nav-logo.png" alt="SparkVenture" class="h-10 w-auto object-contain" />
        </a>

        <div class="mb-5 rounded-xl border border-blue-100 bg-blue-50 px-4 py-3">
            <p class="text-xs font-bold uppercase tracking-wide text-blue-600">Active business</p>
            <p class="mt-1 truncate text-sm font-extrabold text-blue-950">
                @(activeBusinessId.HasValue ? activeBusinessName : "Select a business")
            </p>
            <a href="@businessesUrl" class="mt-2 inline-block text-xs font-bold text-blue-700 hover:text-blue-900">
                @(activeBusinessId.HasValue ? "Switch business →" : "Choose business →")
            </a>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto" aria-label="Business navigation">
            @foreach (var item in nav)
            {
                // A business Details page IS the workspace, even though its
                // MVC controller is Businesses.
                var isWorkspace = item.Controller == "BusinessWorkspace" &&
                    currentController == "Businesses" && currentAction == "Details";
                var active = isWorkspace ||
                    (currentController == item.Controller &&
                     !(item.Controller == "Businesses" && currentAction == "Details"));
                <a href="@item.Href" aria-current="@(active ? "page" : null)"
                   class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition @(active ? "bg-blue-600 text-white shadow-lg shadow-blue-200" : "text-blue-900 hover:bg-blue-50")">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        @Html.Raw(item.Icon)
                    </svg>
                    <span>@item.Label</span>
                    @if (item.Controller == "Notifications")
                    {
                        <span id="notificationBadgeContainer" class="ml-auto" data-unread-url="@Url.Action("UnreadCount", "Notifications")">
                            @await Component.InvokeAsync("NotificationBadge", new { dotOnly = false })
                        </span>
                    }
                </a>
            }
        </nav>

        <div class="border-t border-blue-100 pt-4">
            <a href="@settingsUrl" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold text-blue-900 hover:bg-blue-50">
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
                Account Settings
            </a>
        </div>
    </aside>

    <div class="lg:pl-72">
        <header class="sticky top-0 z-20 border-b border-blue-100 bg-white/90 backdrop-blur">
            <div class="flex items-center justify-between gap-4 px-5 py-3 lg:px-8">
                <button id="sidebarToggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar"
                        class="rounded-lg p-2 text-blue-950 hover:bg-blue-50 lg:hidden">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>

                <div class="min-w-0">
                    <p class="hidden text-xs font-bold uppercase tracking-wide text-blue-600 sm:block">SparkVenture</p>
                    <p class="max-w-44 truncate text-sm font-semibold text-blue-950 sm:max-w-xs">@(activeBusinessId.HasValue ? activeBusinessName : "Your business")</p>
                </div>

                <div class="flex items-center gap-3">
                    <a href="@workspaceUrl" class="hidden rounded-lg border border-blue-200 px-3 py-2 text-xs font-bold text-blue-700 hover:bg-blue-50 sm:inline-flex">Open Workspace</a>
                    <details class="relative">
                        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full bg-blue-100 text-sm font-extrabold text-blue-700 hover:bg-blue-200" aria-label="Account menu">@initial</summary>
                        <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-blue-100 bg-white p-2 shadow-xl">
                            <p class="truncate px-3 py-2 text-xs text-slate-500">@User.Identity?.Name</p>
                            <a href="@settingsUrl" class="block rounded-lg px-3 py-2 text-sm font-semibold text-blue-950 hover:bg-blue-50">Account settings</a>
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")">
                                <button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-sm font-semibold text-red-600 hover:bg-red-50">Sign out</button>
                            </form>
                        </div>
                    </details>
                </div>
            </div>
        </header>

        <main class="mx-auto max-w-7xl px-5 py-8 lg:px-8">@RenderBody()</main>
    </div>

    <script>
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("sidebarOverlay");
        const toggle = document.getElementById("sidebarToggle");
        function setSidebar(open) {
            sidebar.classList.toggle("-translate-x-full", !open);
            overlay.classList.toggle("hidden", !open);
            toggle?.setAttribute("aria-expanded", String(open));
        }
        toggle?.addEventListener("click", () => setSidebar(sidebar.classList.contains("-translate-x-full")));
        overlay?.addEventListener("click", () => setSidebar(false));
        document.addEventListener("keydown", e => { if (e.key === "Escape") setSidebar(false); });

        // The existing Notifications/UnreadCount endpoint is optional.
        // If it is present, update the badge on load and every 15 seconds.
        const badgeContainer = document.getElementById("notificationBadgeContainer");
        async function refreshNotificationBadge() {
            if (!badgeContainer || !badgeContainer.dataset.unreadUrl) return;
            try {
                const response = await fetch(badgeContainer.dataset.unreadUrl, {
                    cache: "no-store", credentials: "same-origin"
                });
                if (!response.ok) return;
                const data = await response.json();
                const count = Number(data.count);
                if (!Number.isFinite(count) || count < 0) return;
                if (count === 0) { badgeContainer.replaceChildren(); return; }
                const badge = document.createElement("span");
                badge.className = "inline-flex min-w-5 items-center justify-center rounded-full bg-red-500 px-1.5 py-0.5 text-xs font-bold text-white";
                badge.textContent = count > 99 ? "99+" : String(count);
                badge.setAttribute("aria-label", `${count} unread notifications`);
                badgeContainer.replaceChildren(badge);
            } catch { /* Keep the server-rendered badge if the request fails. */ }
        }
        refreshNotificationBadge();
        setInterval(refreshNotificationBadge, 15000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
