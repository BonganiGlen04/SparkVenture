
@model SparkVenture.ViewModels.NotificationBadgeViewModel

@if (Model.Count > 0)
{
    if (Model.DotOnly)
    {
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-red-500"
              aria-label="@Model.Count unread notifications">
        </span>
    }
    else
    {
        <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-red-500 px-1.5 py-0.5 text-xs font-bold text-white"
              aria-label="@Model.Count unread notifications">

            @(Model.Count > 99 ? "99+" : Model.Count.ToString())

        </span>
    }
}
