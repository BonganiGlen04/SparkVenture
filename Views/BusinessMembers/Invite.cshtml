@model SparkVenture.ViewModels.InviteBusinessMemberViewModel
@{
    ViewData["Title"] = "Invite Team Member";
    Layout = "_DashboardLayout";
    var inputClass = "mt-2 w-full rounded-xl border border-blue-200 bg-white px-4 py-3 text-sm text-blue-950 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100";
}

<div class="space-y-6">
    <a asp-controller="BusinessMembers" asp-action="Index" asp-route-businessId="@Model.BusinessId"
       class="text-sm font-bold text-blue-600 hover:text-blue-800">← Back to Team Members</a>

    <div>
        <p class="mt-6 text-xs font-extrabold tracking-widest text-blue-600 uppercase">Business management</p>
        <h1 class="mt-2 text-3xl font-extrabold text-blue-950">Invite a team member</h1>
        <p class="mt-2 text-sm text-slate-600">Give someone secure access to <strong>@Model.BusinessName</strong>.</p>
    </div>

    <form asp-action="Invite" asp-controller="BusinessMembers" method="post"
          class="space-y-6 rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">
        @Html.AntiForgeryToken()
        <input asp-for="BusinessId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <div>
            <label asp-for="Email" class="block text-sm font-bold text-blue-950"></label>
            <input asp-for="Email" type="email" maxlength="254" autocomplete="email" required
                   placeholder="teammate@example.com" class="@inputClass" />
            <span asp-validation-for="Email" class="mt-2 block text-xs text-red-600"></span>
            <p class="mt-2 text-xs text-slate-500">They can accept using an existing account or register a new one with this email.</p>
        </div>

        <div>
            <label asp-for="Role" class="block text-sm font-bold text-blue-950"></label>
            <select asp-for="Role" class="@inputClass">
                <option value="Manager">Manager — help manage business operations</option>
                <option value="Accountant">Accountant — accounting and finance work</option>
                <option value="Advisor">Advisor — support and guidance</option>
                <option value="Observer">Observer — limited viewing access</option>
            </select>
            <span asp-validation-for="Role" class="mt-2 block text-xs text-red-600"></span>
            <p class="mt-2 text-xs text-slate-500">Business Owner access cannot be granted from invitations.</p>
        </div>

        <div class="rounded-xl border border-blue-100 bg-blue-50 p-4 text-xs leading-6 text-blue-900">
            The invitation expires after 7 days and can be accepted once. The recipient must confirm ownership of the invited email address.
        </div>
        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <a asp-action="Index" asp-route-businessId="@Model.BusinessId"
               class="rounded-xl border border-blue-200 px-5 py-3 text-center text-sm font-bold text-blue-700 hover:bg-blue-50">Cancel</a>
            <button type="submit" class="rounded-xl bg-blue-600 px-7 py-3 text-sm font-bold text-white hover:bg-blue-700">
                Create invitation →
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
