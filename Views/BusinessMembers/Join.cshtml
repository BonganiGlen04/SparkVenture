@model SparkVenture.ViewModels.JoinBusinessInvitationViewModel
@{
    Layout = null; // Invitees may be anonymous, so avoid authenticated dashboard layout.
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Join a business - SparkVenture</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen items-center justify-center bg-gradient-to-br from-blue-50 via-white to-sky-100 p-5 text-slate-700">
    <main class="w-full max-w-xl rounded-2xl border border-blue-100 bg-white p-8 shadow-xl">
        <img src="~/images/nav-logo.png" alt="SparkVenture" class="h-12 w-auto object-contain" />
        <p class="mt-8 text-xs font-extrabold uppercase tracking-widest text-blue-600">Team invitation</p>
        <h1 class="mt-2 text-3xl font-extrabold text-blue-950">You've been invited to a business</h1>
        <p class="mt-4 text-sm leading-6 text-slate-600">
            Sign in with the email address that received the invitation, or create an account with that address.
            You must verify the email before accepting.
        </p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <a href="@Model.LoginUrl" class="rounded-xl bg-blue-600 px-5 py-3 text-center text-sm font-bold text-white hover:bg-blue-700">Sign in</a>
            <a href="@Model.RegisterUrl" class="rounded-xl border border-blue-200 px-5 py-3 text-center text-sm font-bold text-blue-700 hover:bg-blue-50">Create account</a>
        </div>
        <p class="mt-6 text-xs text-slate-500">Invitation details are shown only after your invited email address is verified.</p>
    </main>
</body>
</html>
