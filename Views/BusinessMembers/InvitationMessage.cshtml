@model SparkVenture.ViewModels.InvitationMessageViewModel
@{
    ViewData["Title"] = Model.Heading;
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>@Model.Heading - SparkVenture</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen items-center justify-center bg-blue-50 p-5 text-slate-700">
    <main class="w-full max-w-xl rounded-2xl border border-blue-100 bg-white p-8 shadow-sm">
        <img src="~/images/nav-logo.png" alt="SparkVenture" class="h-12 w-auto object-contain" />
        <h1 class="mt-8 text-2xl font-extrabold text-blue-950">@Model.Heading</h1>
        <p class="mt-3 text-sm leading-6 text-slate-600">@Model.Message</p>
        <a asp-controller="Home" asp-action="Index" class="mt-7 inline-flex rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">Back to SparkVenture</a>
    </main>
</body>
</html>
