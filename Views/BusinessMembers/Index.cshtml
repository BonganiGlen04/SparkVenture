@model SparkVenture.ViewModels.BusinessMembersIndexViewModel
@{
    ViewData["Title"] = "Team Members";
    Layout = "_DashboardLayout";
}

<div class="space-y-6">
    <div>
        <a asp-controller="Businesses" asp-action="Details" asp-route-id="@Model.BusinessId"
           class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 hover:text-blue-800">
            <span aria-hidden="true">←</span> Back to business profile
        </a>
        <div class="mt-5 flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-blue-600">Business Management</p>
                <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-blue-950 sm:text-4xl">Team Members</h1>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Manage access to <span class="font-semibold text-blue-950">@Model.BusinessName</span>.
                </p>
            </div>
            @if (Model.CanManageMembers)
            {
                <span class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-700">
                    Invitations: next implementation step
                </span>
            }
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Active members</p>
            <p class="mt-2 text-3xl font-extrabold text-blue-950">@Model.ActiveCount</p>
        </div>
        <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Pending memberships</p>
            <p class="mt-2 text-3xl font-extrabold text-blue-950">@Model.PendingMembershipCount</p>
        </div>
        <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Your role</p>
            <p class="mt-3 text-lg font-extrabold text-blue-950">@Model.CurrentUserRole</p>
        </div>
    </div>

    <section class="overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-sm" aria-labelledby="members-heading">
        <div class="border-b border-blue-100 p-6 sm:p-8">
            <h2 id="members-heading" class="text-xl font-extrabold text-blue-950">Business team</h2>
            <p class="mt-1 text-sm text-slate-500">People with current or pending membership records for this business.</p>
        </div>

        @if (!Model.Members.Any())
        {
            <div class="p-10 text-center text-sm text-slate-500">No team members found.</div>
        }
        else
        {
            <ul class="divide-y divide-blue-50">
                @foreach (var member in Model.Members)
                {
                    var isActive = member.Status == "Active";
                    <li class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
                        <div class="flex min-w-0 items-center gap-4">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blue-100 font-extrabold text-blue-700" aria-hidden="true">
                                @(string.IsNullOrWhiteSpace(member.DisplayName) ? "?" : member.DisplayName.Substring(0, 1).ToUpperInvariant())
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-extrabold text-blue-950">
                                    @member.DisplayName
                                    @if (member.IsCurrentUser)
                                    {
                                        <span class="ml-1 text-xs font-semibold text-slate-500">(you)</span>
                                    }
                                </p>
                                <p class="mt-1 break-all text-xs text-slate-500">@member.Email</p>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 pl-14 sm:pl-0">
                            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@member.Role</span>
                            <span class="rounded-full px-3 py-1 text-xs font-bold @(isActive ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-800")">
                                @member.Status
                            </span>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    @if (Model.CanManageMembers)
    {
        <section class="overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-sm" aria-labelledby="invites-heading">
            <div class="p-6 sm:p-8">
                <h2 id="invites-heading" class="text-lg font-extrabold text-blue-950">Pending invitations</h2>
                <p class="mt-1 text-sm text-slate-500">Invitations that have not been accepted and have not expired.</p>

                @if (!Model.PendingInvitations.Any())
                {
                    <p class="mt-5 rounded-xl bg-blue-50 p-5 text-sm text-blue-900">No outstanding invitations.</p>
                }
                else
                {
                    <ul class="mt-5 divide-y divide-blue-50">
                        @foreach (var invitation in Model.PendingInvitations)
                        {
                            <li class="flex flex-wrap justify-between gap-3 py-4">
                                <div class="min-w-0">
                                    <p class="break-all text-sm font-bold text-blue-950">@invitation.Email</p>
                                    <p class="mt-1 text-xs text-slate-500">Invited as @invitation.Role</p>
                                </div>
                                <span class="text-xs font-semibold text-amber-700">
                                    Expires @invitation.ExpiresAtUtc.ToString("dd MMM yyyy") UTC
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    }

    <div class="rounded-2xl border border-blue-100 bg-blue-50 p-5 text-sm leading-6 text-blue-900">
        Only an authorised active business member can view this team list. Invitation, role changes and revocation will be added as separate, tested actions.
    </div>
</div>
