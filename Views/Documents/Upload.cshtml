@model SparkVenture.ViewModels.UploadBusinessDocumentViewModel
@{
    ViewData["Title"] = "Upload Business Document";
    Layout = "_DashboardLayout";
    var input = "mt-2 block w-full rounded-xl border border-blue-100 bg-white px-4 py-3 text-sm text-blue-950 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100";
}

<div class="mb-8">
    <a asp-controller="Documents" asp-action="Index" asp-route-businessId="@Model.BusinessId"
       class="text-sm font-semibold text-blue-600 hover:text-blue-800">← Back to Document Vault</a>
    <p class="mt-6 text-xs font-bold uppercase tracking-widest text-blue-600">Business Documents</p>
    <h1 class="mt-2 text-3xl font-extrabold text-blue-950 sm:text-4xl">Upload Document</h1>
    <p class="mt-3 text-sm text-slate-600">Add a document to <strong class="text-blue-950">@Model.BusinessName</strong>.</p>
</div>

<div class="grid items-start gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
        <form asp-controller="Documents" asp-action="Upload" method="post"
              enctype="multipart/form-data" class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">
            @Html.AntiForgeryToken()
            <input asp-for="BusinessId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm font-semibold text-red-600"></div>

            <div>
                <label asp-for="DocumentPurpose" class="block text-sm font-bold text-blue-950">Document type <span class="text-red-500">*</span></label>
                <select asp-for="DocumentPurpose" asp-items="Model.DocumentPurposes" class="@input">
                    <option value="">Select document type</option>
                </select>
                <span asp-validation-for="DocumentPurpose" class="mt-1 block text-xs text-red-600"></span>
            </div>

            <div class="mt-7">
                <label asp-for="File" class="block text-sm font-bold text-blue-950">Choose a file <span class="text-red-500">*</span></label>
                <div class="mt-2 rounded-2xl border-2 border-dashed border-blue-200 bg-blue-50/60 px-5 py-8 text-center">
                    <span class="text-4xl" aria-hidden="true">📄</span>
                    <p class="mt-3 text-sm font-bold text-blue-950">Select a PDF or image</p>
                    <p class="mt-1 text-xs text-slate-500">PDF, PNG or JPEG · Up to 10 MB</p>
                    <input asp-for="File" type="file" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg"
                           class="mt-5 block w-full cursor-pointer text-sm text-slate-600 file:mr-4 file:cursor-pointer file:rounded-xl file:border-0 file:bg-blue-600 file:px-4 file:py-2.5 file:font-bold file:text-white hover:file:bg-blue-700" />
                </div>
                <span asp-validation-for="File" class="mt-1 block text-xs text-red-600"></span>
            </div>

            <div class="mt-6 rounded-xl border border-blue-100 bg-blue-50 p-4">
                <p class="text-xs leading-6 text-blue-900">
                    We store this file privately and attach it to the selected business.
                    It will remain <strong>Pending safety check</strong> until malware scanning is connected.
                </p>
            </div>

            <div class="mt-8 flex flex-col-reverse gap-3 border-t border-blue-100 pt-6 sm:flex-row sm:justify-between">
                <a asp-controller="Documents" asp-action="Index" asp-route-businessId="@Model.BusinessId"
                   class="rounded-xl border border-blue-200 px-6 py-3 text-center text-sm font-bold text-blue-700 hover:bg-blue-50">
                    Cancel
                </a>
                <button type="submit" class="rounded-xl bg-blue-600 px-7 py-3 text-sm font-bold text-white shadow-lg shadow-blue-200 hover:bg-blue-700">
                    Upload Document →
                </button>
            </div>
        </form>
    </div>
    <aside class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-2xl" aria-hidden="true">🔒</div>
        <h2 class="mt-4 text-lg font-extrabold text-blue-950">Keep your records organised</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Upload the certificate or proof once and link it to business workflows later.</p>
        <ul class="mt-5 space-y-3 text-sm text-slate-600">
            <li>✓ Private business-only records</li>
            <li>✓ Randomised storage keys</li>
            <li>✓ Server-side file size and type checks</li>
            <li>✓ No public file URLs</li>
        </ul>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
