@model SparkVenture.ViewModels.FinanceInsightsVm
@{ ViewData["Title"] = "Financial insights"; Layout = "_DashboardLayout"; }
<div class="mb-6"><p class="text-xs font-bold uppercase tracking-widest text-blue-600">Phase C5 · @Model.BusinessName</p><h1 class="mt-2 text-3xl font-extrabold text-blue-950">Financial insights</h1><p class="mt-2 text-sm text-slate-600">Understand recorded cash movement and unpaid invoices. All amounts are in ZAR.</p></div>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div class="rounded-2xl border border-blue-100 bg-white p-5"><p class="text-xs text-slate-500">Money in this month</p><p class="mt-2 text-2xl font-extrabold text-emerald-700">R @Model.CurrentMonthMoneyIn.ToString("N2")</p></div><div class="rounded-2xl border border-blue-100 bg-white p-5"><p class="text-xs text-slate-500">Money out this month</p><p class="mt-2 text-2xl font-extrabold text-red-700">R @Model.CurrentMonthMoneyOut.ToString("N2")</p></div><div class="rounded-2xl border border-blue-100 bg-white p-5"><p class="text-xs text-slate-500">Total invoice balance owed</p><p class="mt-2 text-2xl font-extrabold text-blue-950">R @Model.OutstandingInvoices.ToString("N2")</p></div><div class="rounded-2xl border border-blue-100 bg-white p-5"><p class="text-xs text-slate-500">Overdue invoices (@Model.OverdueCount)</p><p class="mt-2 text-2xl font-extrabold text-amber-700">R @Model.OverdueInvoices.ToString("N2")</p></div></div>
<div class="mt-6 grid gap-5 lg:grid-cols-2"><section class="rounded-2xl border border-blue-100 bg-white p-6"><h2 class="text-lg font-bold text-blue-950">Six-month cash movement</h2><p class="mt-1 text-xs text-slate-500">Posted non-reversed Cashbook entries. Net = receipts minus outflows, not accounting profit.</p><div class="mt-4 overflow-x-auto"><table class="min-w-full text-sm"><thead class="bg-blue-50 text-left"><tr><th class="p-3">Month</th><th class="p-3 text-right">In</th><th class="p-3 text-right">Out</th><th class="p-3 text-right">Net</th></tr></thead><tbody>@foreach(var month in Model.Months){<tr class="border-b border-blue-50"><td class="p-3">@month.Month</td><td class="p-3 text-right">@month.MoneyIn.ToString("N2")</td><td class="p-3 text-right">@month.MoneyOut.ToString("N2")</td><td class="p-3 text-right font-bold @(month.Net<0 ? "text-red-700" : "text-emerald-700")">@month.Net.ToString("N2")</td></tr>}</tbody></table></div></section>
<section class="rounded-2xl border border-blue-100 bg-white p-6"><h2 class="text-lg font-bold text-blue-950">Estimated monthly net movement</h2>@if(Model.EstimatedNextMonthNet.HasValue){<p class="mt-4 text-3xl font-extrabold text-blue-950">R @Model.EstimatedNextMonthNet.Value.ToString("N2")</p><p class="mt-3 text-sm text-slate-600">Simple arithmetic average of the last @Model.ForecastMonthsUsed completed months, assuming similar business conditions. <strong>Not guaranteed revenue, cash balance or a machine-learning prediction.</strong></p>}else{<p class="mt-4 text-sm text-slate-600">Not enough transaction history yet. We need recorded activity in at least three completed months before showing this estimate.</p>}<h3 class="mt-8 text-sm font-extrabold text-blue-950">Suggested next actions</h3><ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-slate-700">@foreach(var action in Model.NextActions){<li>@action</li>}</ul></section></div>
<p class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">These figures depend on accurate Cashbook and invoice records. They exclude future commitments, taxes, bank charges not recorded, and receivables not yet collected. They are decision-support indicators, not audited accounts or financial advice.</p>
<div class="mt-6 flex flex-wrap gap-4 text-sm font-bold"><a asp-controller="Cashbook" asp-action="Reports" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Cashbook reports</a><a asp-controller="Invoices" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Invoices</a><a asp-controller="Payments" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Payments</a></div>
