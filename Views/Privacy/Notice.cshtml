@model SparkVenture.ViewModels.PrivacyNoticeVm
@{ ViewData["Title"]="Privacy notice"; Layout=User.Identity?.IsAuthenticated==true ? "_DashboardLayout" : "_Layout"; }
<section class="mx-auto max-w-4xl rounded-2xl border border-blue-100 bg-white p-6 shadow-sm sm:p-9">
<p class="text-xs font-bold uppercase tracking-widest text-blue-600">SparkVenture · Privacy</p>
<h1 class="mt-3 text-3xl font-extrabold text-blue-950">Privacy notice</h1>
@if(Model.IsDemoOrMissing){<div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">This is demonstration or missing notice content. It is not a real privacy policy. An administrator must publish a properly reviewed version before production use.</div>}
<p class="mt-3 text-xs text-slate-500">Version @(string.IsNullOrEmpty(Model.VersionLabel)?"Not yet published":Model.VersionLabel) · @(Model.PublishedAtUtc?.ToString("dd MMM yyyy")??"Unpublished")</p>
<div class="mt-6 whitespace-pre-wrap break-words text-sm leading-7 text-slate-700">@Model.Text</div>
@if(User.Identity?.IsAuthenticated==true){<a asp-action="Index" class="mt-7 inline-block text-sm font-bold text-blue-700">Manage your privacy choices →</a>}
</section>
