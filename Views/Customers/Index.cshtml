@model SparkVenture.ViewModels.CustomersIndexVm
@{ ViewData["Title"] = "Customers"; Layout = "_DashboardLayout"; }
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div><p class="text-xs font-bold uppercase tracking-widest text-blue-600">Phase C2 · @Model.BusinessName</p><h1 class="mt-2 text-3xl font-extrabold text-blue-950">Customers</h1><p class="mt-1 text-sm text-slate-500">Keep customer contacts separate for each business.</p></div>
    @if (Model.CanEdit) { <a asp-action="Create" asp-route-businessId="@Model.BusinessId" class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700">+ Add customer</a> }
</div>
@if (TempData["SuccessMessage"] is string msg) { <p role="status" class="mb-4 rounded-xl bg-emerald-50 p-4 text-emerald-800">@msg</p> }
<form asp-action="Index" method="get" class="mb-5 flex flex-wrap gap-2"><input type="hidden" name="businessId" value="@Model.BusinessId"/><input name="search" value="@Model.Search" placeholder="Search customers" class="w-full max-w-sm rounded-xl border border-blue-200 p-3"/><button class="rounded-xl border border-blue-200 px-4 py-3 font-bold text-blue-700">Search</button></form>
<div class="overflow-x-auto rounded-2xl border border-blue-100 bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="bg-blue-50 text-blue-950"><tr><th class="p-4">Customer</th><th class="p-4">Type</th><th class="p-4">Contact</th><th class="p-4">Actions</th></tr></thead><tbody class="divide-y divide-blue-50">@foreach(var c in Model.Customers){<tr><td class="p-4 font-bold text-blue-950">@c.Name</td><td class="p-4">@c.CustomerType</td><td class="p-4">@c.Email <span class="text-slate-400">@c.Phone</span></td><td class="p-4">@if(Model.CanEdit){<a class="font-bold text-blue-600 hover:underline" asp-action="Edit" asp-route-businessId="@Model.BusinessId" asp-route-id="@c.CustomerId">Edit</a>}</td></tr>}</tbody></table>@if(Model.Customers.Count==0){<p class="p-8 text-center text-slate-500">No customers yet. Add one before creating an invoice.</p>}</div>
<div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold"><a asp-controller="Invoices" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700 hover:underline">Go to invoices →</a><a asp-controller="Cashbook" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700 hover:underline">Cashbook</a></div>
