@model SparkVenture.ViewModels.CustomerFormVm
@{ var editing=Model.CustomerId.HasValue; ViewData["Title"] = editing ? "Edit customer" : "New customer"; Layout = "_DashboardLayout"; }
<a asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-sm font-bold text-blue-600">← Customers</a>
<div class="mt-5 max-w-2xl rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
<h1 class="mb-5 text-2xl font-extrabold text-blue-950">@(editing ? "Edit customer" : "Add customer")</h1>
<form asp-action="@(editing ? "Edit" : "Create")" method="post" class="space-y-5">
@Html.AntiForgeryToken()<input asp-for="BusinessId" type="hidden"/><input asp-for="CustomerId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
<div><label asp-for="DisplayName" class="mb-1 block text-sm font-bold">Customer name</label><input asp-for="DisplayName" class="w-full rounded-xl border border-blue-200 p-3"/><span asp-validation-for="DisplayName" class="text-xs text-red-700"></span></div>
<div><label asp-for="CustomerType" class="mb-1 block text-sm font-bold">Customer type</label><select asp-for="CustomerType" class="w-full rounded-xl border border-blue-200 p-3"><option>Individual</option><option>Business</option><option>Government</option><option>Institution</option></select><span asp-validation-for="CustomerType" class="text-xs text-red-700"></span></div>
<div><label asp-for="Email" class="mb-1 block text-sm font-bold">Email (optional)</label><input asp-for="Email" type="email" class="w-full rounded-xl border border-blue-200 p-3"/><span asp-validation-for="Email" class="text-xs text-red-700"></span></div>
<div><label asp-for="Phone" class="mb-1 block text-sm font-bold">Phone (optional)</label><input asp-for="Phone" class="w-full rounded-xl border border-blue-200 p-3"/><span asp-validation-for="Phone" class="text-xs text-red-700"></span></div>
<button type="submit" class="rounded-xl bg-blue-600 px-6 py-3 font-bold text-white hover:bg-blue-700">Save customer</button>
</form></div>
