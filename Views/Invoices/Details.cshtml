@model SparkVenture.ViewModels.InvoiceDetailsVm
@{ ViewData["Title"] = "Invoice " + Model.Number; Layout = "_DashboardLayout"; }
<a asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-sm font-bold text-blue-600">← Invoices</a>
@if(TempData["SuccessMessage"] is string msg){<p class="mt-4 rounded-xl bg-emerald-50 p-4 text-emerald-800">@msg</p>}
<div class="mt-5 rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
<div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-blue-600">Invoice</p><h1 class="text-3xl font-extrabold text-blue-950">@Model.Number</h1><p class="mt-2 text-sm text-slate-600">Customer: @Model.CustomerName</p></div><div class="text-right"><span class="rounded-full bg-blue-50 px-3 py-2 text-xs font-bold text-blue-800">@Model.Status</span><p class="mt-4 text-xs">Issued: @Model.IssueDate.ToString("dd MMM yyyy")</p><p class="text-xs">Due: @Model.DueDate.ToString("dd MMM yyyy")</p></div></div>
<div class="mt-6 overflow-x-auto"><table class="min-w-full text-sm"><thead class="bg-blue-50 text-left"><tr><th class="p-3">Description</th><th class="p-3 text-right">Qty</th><th class="p-3 text-right">Price</th><th class="p-3 text-right">Total</th></tr></thead><tbody>@foreach(var l in Model.Lines){<tr class="border-b border-blue-50"><td class="p-3">@l.Description</td><td class="p-3 text-right">@l.Quantity.ToString("N2")</td><td class="p-3 text-right">R @l.UnitPrice.ToString("N2")</td><td class="p-3 text-right">R @l.LineTotal.ToString("N2")</td></tr>}</tbody></table></div>
<div class="mt-6 ml-auto max-w-xs space-y-2 text-sm"><div class="flex justify-between"><span>Subtotal</span><strong>R @Model.Subtotal.ToString("N2")</strong></div><div class="flex justify-between"><span>VAT / tax amount</span><strong>R @Model.TaxAmount.ToString("N2")</strong></div><div class="flex justify-between border-t pt-2"><span>Total</span><strong>R @Model.Total.ToString("N2")</strong></div><div class="flex justify-between"><span>Received</span><strong>R @Model.Paid.ToString("N2")</strong></div><div class="flex justify-between text-blue-900"><span>Outstanding</span><strong>R @Model.Outstanding.ToString("N2")</strong></div></div>
@if(Model.CanEdit){<div class="mt-6 flex flex-wrap gap-3">@if(Model.Status=="Draft") {<a asp-action="Edit" asp-route-businessId="@Model.BusinessId" asp-route-id="@Model.InvoiceId" class="rounded-xl border border-blue-200 px-5 py-3 text-sm font-bold text-blue-700">Edit draft</a><form asp-action="Issue" method="post" onsubmit="return confirm('Mark this invoice as issued? This does NOT email it.');">@Html.AntiForgeryToken()<input type="hidden" name="businessId" value="@Model.BusinessId"/><input type="hidden" name="id" value="@Model.InvoiceId"/><button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white">Mark as issued</button></form>}else if(Model.Outstanding>0){<a asp-controller="Payments" asp-action="Record" asp-route-businessId="@Model.BusinessId" asp-route-invoiceId="@Model.InvoiceId" class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white">Record received payment</a>}</div>}
</div><p class="mt-4 text-xs text-amber-700">Issued is a SparkVenture record status. No invoice email, PDF or card payment was sent or processed by this action.</p>
