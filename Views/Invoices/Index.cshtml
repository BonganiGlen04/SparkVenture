@model SparkVenture.ViewModels.InvoicesIndexVm
@{ ViewData["Title"] = "Invoices"; Layout = "_DashboardLayout"; }
<div class="mb-6 flex flex-wrap items-center justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-blue-600">Phase C3 · @Model.BusinessName</p><h1 class="mt-2 text-3xl font-extrabold text-blue-950">Invoices</h1><p class="mt-2 text-sm text-slate-500">Draft, issue and track amounts owed by customers.</p></div>@if(Model.CanEdit){<a asp-action="Create" asp-route-businessId="@Model.BusinessId" class="rounded-xl bg-blue-600 px-5 py-3 font-bold text-white">+ New invoice</a>}</div>
@if(TempData["SuccessMessage"] is string msg){<p class="mb-4 rounded-xl bg-emerald-50 p-4 text-emerald-800">@msg</p>}
<div class="overflow-x-auto rounded-2xl border border-blue-100 bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="bg-blue-50 text-blue-950"><tr><th class="p-4">Invoice</th><th class="p-4">Customer</th><th class="p-4">Status</th><th class="p-4">Due</th><th class="p-4 text-right">Total (R)</th><th class="p-4 text-right">Outstanding (R)</th></tr></thead><tbody class="divide-y divide-blue-50">@foreach(var item in Model.Invoices){<tr><td class="p-4"><a asp-action="Details" asp-route-businessId="@Model.BusinessId" asp-route-id="@item.InvoiceId" class="font-bold text-blue-700 hover:underline">@item.Number</a></td><td class="p-4">@item.CustomerName</td><td class="p-4"><span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-800">@item.Status</span></td><td class="p-4">@item.DueDate.ToString("dd MMM yyyy")</td><td class="p-4 text-right">@item.Total.ToString("N2")</td><td class="p-4 text-right font-bold">@item.Outstanding.ToString("N2")</td></tr>}</tbody></table>@if(Model.Invoices.Count==0){<p class="p-8 text-center text-slate-500">No invoices yet. Add a customer, then create your first draft.</p>}</div>
<div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold"><a asp-controller="Customers" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Customers</a><a asp-controller="Payments" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Payments</a><a asp-controller="FinanceInsights" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-blue-700">Financial insights →</a></div>
