@model SparkVenture.ViewModels.InvoiceFormVm
@{ var editing=Model.InvoiceId.HasValue; ViewData["Title"] = editing ? "Edit draft" : "New invoice"; Layout = "_DashboardLayout"; }
<a asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-sm font-bold text-blue-600">← Invoices</a>
<div class="mt-5 max-w-4xl rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
<h1 class="mb-2 text-2xl font-extrabold text-blue-950">@(editing ? "Edit draft invoice" : "Create draft invoice")</h1><p class="mb-5 text-sm text-slate-500">No invoice will be emailed or payment collected automatically.</p>
<form method="post" asp-action="@(editing ? "Edit" : "Create")" id="invoiceForm" class="space-y-5">
@Html.AntiForgeryToken()<input asp-for="BusinessId" type="hidden"/><input asp-for="InvoiceId" type="hidden"/><div asp-validation-summary="All" class="text-sm text-red-700"></div>
<div><label asp-for="CustomerId" class="mb-1 block text-sm font-bold">Customer</label><select asp-for="CustomerId" asp-items="Model.Customers" class="w-full rounded-xl border border-blue-200 p-3"><option value="">Choose customer</option></select><span asp-validation-for="CustomerId" class="text-xs text-red-700"></span><a asp-controller="Customers" asp-action="Create" asp-route-businessId="@Model.BusinessId" class="mt-1 block text-xs font-bold text-blue-600">+ Add customer</a></div>
<div class="grid gap-4 sm:grid-cols-2"><div><label asp-for="IssueDate" class="mb-1 block text-sm font-bold">Issue date</label><input asp-for="IssueDate" type="date" class="w-full rounded-xl border border-blue-200 p-3"/></div><div><label asp-for="DueDate" class="mb-1 block text-sm font-bold">Due date</label><input asp-for="DueDate" type="date" class="w-full rounded-xl border border-blue-200 p-3"/></div></div>
<div><label asp-for="TaxRatePercent" class="mb-1 block text-sm font-bold">VAT rate (if applicable)</label><select asp-for="TaxRatePercent" class="w-full rounded-xl border border-blue-200 p-3"><option value="0">0% — no VAT added</option><option value="15">15% — only if VAT is appropriate</option></select><p class="mt-1 text-xs text-amber-700">Do not add VAT unless the business is authorised/required to charge it. This MVP is not tax advice.</p></div>
<div class="border-t border-blue-100 pt-5"><h2 class="mb-3 text-lg font-bold text-blue-950">Invoice items</h2><p class="mb-3 text-xs text-slate-500">Up to 20 lines. To remove a line, clear its description and price.</p>
<div id="invoiceLines" class="space-y-3">@for(var i=0;i<Model.Lines.Count;i++){<div class="grid gap-3 rounded-xl bg-blue-50 p-3 sm:grid-cols-6"><div class="sm:col-span-3"><label class="block text-xs font-bold">Description</label><input asp-for="Lines[i].Description" class="w-full rounded-lg border border-blue-200 p-2"/></div><div><label class="block text-xs font-bold">Quantity</label><input asp-for="Lines[i].Quantity" type="number" min="0.0001" step="0.0001" class="w-full rounded-lg border border-blue-200 p-2"/></div><div class="sm:col-span-2"><label class="block text-xs font-bold">Price per unit (R)</label><input asp-for="Lines[i].UnitPrice" type="number" min="0" step="0.01" class="w-full rounded-lg border border-blue-200 p-2"/></div></div>}</div>
<button type="button" id="addLine" class="mt-3 rounded-xl border border-blue-300 px-4 py-2 text-sm font-bold text-blue-700">+ Add another item</button></div>
<button type="submit" class="rounded-xl bg-blue-600 px-6 py-3 font-bold text-white">Save draft</button>
</form></div>
<template id="invoiceLineTemplate"><div class="grid gap-3 rounded-xl bg-blue-50 p-3 sm:grid-cols-6"><div class="sm:col-span-3"><label class="block text-xs font-bold">Description</label><input name="Lines[__INDEX__].Description" maxlength="200" class="w-full rounded-lg border border-blue-200 p-2"/></div><div><label class="block text-xs font-bold">Quantity</label><input name="Lines[__INDEX__].Quantity" type="number" min="0.0001" step="0.0001" value="1" class="w-full rounded-lg border border-blue-200 p-2"/></div><div class="sm:col-span-2"><label class="block text-xs font-bold">Price per unit (R)</label><input name="Lines[__INDEX__].UnitPrice" type="number" min="0" step="0.01" value="0" class="w-full rounded-lg border border-blue-200 p-2"/></div></div></template>
@section Scripts { <script>document.getElementById('addLine').addEventListener('click',()=>{const host=document.getElementById('invoiceLines');const i=host.children.length;if(i>=20)return;host.insertAdjacentHTML('beforeend',document.getElementById('invoiceLineTemplate').innerHTML.replaceAll('__INDEX__',String(i)));});</script> }
