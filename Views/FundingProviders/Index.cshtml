@model SparkVenture.ViewModels.FundingProvidersIndexVm
@{
    ViewData["Title"] = "Funding Providers";
    Layout = "_DashboardLayout";
}
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
    <div>
        <p class="text-xs font-bold uppercase tracking-widest text-blue-600">Funding · E1</p>
        <h1 class="mt-2 text-3xl font-extrabold text-blue-950">Explore funding providers</h1>
        <p class="mt-2 text-sm text-slate-600">@Model.BusinessName · Provider directory from local reference data.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-controller="FundingReadiness" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white">Check funding readiness</a>
        <a asp-controller="FundingApplications" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="rounded-xl border border-blue-200 px-4 py-3 text-sm font-bold text-blue-700">My applications</a>
    </div>
</div>
<div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    <strong>Verify current programmes directly with each provider.</strong> Directory records and seeded examples do not prove that a fund is active, open or suitable for your business. Never pay application fees based solely on this list.
</div>
<form method="get" asp-action="Index" class="mb-6 flex flex-wrap gap-3">
    <input type="hidden" name="businessId" value="@Model.BusinessId" />
    <input type="search" name="search" value="@Model.Search" maxlength="100" placeholder="Search provider or type"
           class="min-w-64 flex-1 rounded-xl border border-blue-200 bg-white px-4 py-3 text-sm" />
    <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white">Search</button>
</form>
<div class="grid gap-4 md:grid-cols-2">
    @foreach (var p in Model.Providers)
    {
        var validLink = Uri.TryCreate(p.WebsiteUrl, UriKind.Absolute, out var url) &&
            url.Scheme == Uri.UriSchemeHttps && !url.IsLoopback && string.IsNullOrEmpty(url.UserInfo);
        <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
                <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@p.ProviderType</span>
                @if (p.IsDemo) { <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">Demo record</span> }
            </div>
            <h2 class="mt-4 text-lg font-extrabold text-blue-950">@p.Name</h2>
            <div class="mt-5 flex flex-wrap gap-2">
                @if (validLink && !p.IsDemo)
                {
                    <a href="@p.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="rounded-xl border border-blue-200 px-4 py-2 text-sm font-bold text-blue-700">Visit website</a>
                }
                @if (Model.CanManage)
                {
                    <a asp-controller="FundingApplications" asp-action="Create" asp-route-businessId="@Model.BusinessId"
                       asp-route-providerId="@p.FundingProviderId" class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white">Create local draft</a>
                }
            </div>
        </div>
    }
    @if (!Model.Providers.Any()) { <p class="rounded-xl border border-blue-100 bg-white p-6 text-sm text-slate-600">No matching providers were found.</p> }
</div>
