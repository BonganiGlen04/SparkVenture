@model SparkVenture.ViewModels.RecommendationsIndexVm
@{
    ViewData["Title"] = "Recommended Opportunities";
    Layout = "_DashboardLayout";
}
<a asp-controller="Opportunities" asp-action="Index" asp-route-businessId="@Model.BusinessId" class="text-sm font-bold text-blue-600">← Browse opportunities</a>
<div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <div><p class="text-xs font-extrabold uppercase tracking-widest text-blue-600">Personalised discovery</p>
        <h1 class="mt-1 text-3xl font-extrabold text-blue-950">Recommended for @Model.BusinessName</h1>
        <p class="mt-2 text-sm text-slate-600">Transparent scores from your business profile and known requirements—not AI predictions or proof of eligibility.</p></div>
    @if (Model.CanManage)
    { <form asp-action="SaveSnapshot" method="post">@Html.AntiForgeryToken()
        <input type="hidden" name="businessId" value="@Model.BusinessId" />
        <button type="submit" class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white">Save match snapshot</button></form> }
</div>
<div class="my-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    Checks for things like director age, staff counts or revenue may be unknown. Missing proof is a gap—not a confirmed rejection. Verify official eligibility independently. Demo listings are not live procurement notices.
    @if (Model.LastSavedRunUtc != null) { <p class="mt-1 text-xs">Last snapshot: @Model.LastSavedRunUtc.Value.ToString("dd MMM yyyy HH:mm") UTC</p> }
</div>
<div class="grid gap-4">
    @foreach (var match in Model.Matches)
    {
        <article class="rounded-2xl border border-blue-100 bg-white p-5 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div><h2 class="text-lg font-extrabold text-blue-950">@match.Opportunity.Title</h2>
                    <p class="mt-1 text-xs text-slate-500">@match.Opportunity.Type · @match.Opportunity.SourceName · closes @(match.Opportunity.ClosesAtUtc?.ToString("dd MMM yyyy") ?? "unspecified")</p></div>
                <div class="text-right"><p class="text-xl font-extrabold text-blue-700">@match.IndicativeScore.ToString("N0")%</p>
                    <p class="text-xs text-slate-500">Known-check score</p></div>
            </div>
            <p class="mt-3 text-sm font-semibold text-slate-700">@match.Readiness</p>
            <p class="mt-1 text-xs text-slate-600">@match.Explanation</p>
            @if (match.Gaps.Count > 0) { <ul class="mt-3 list-inside list-disc text-xs text-amber-800">@foreach (var gap in match.Gaps) { <li>@gap</li> }</ul> }
            @if (match.Opportunity.IsDemo) { <p class="mt-2 text-xs font-bold text-amber-800">Demo opportunity — verify independently</p> }
            <a asp-controller="Opportunities" asp-action="Details" asp-route-businessId="@Model.BusinessId"
               asp-route-id="@match.Opportunity.OpportunityId" class="mt-4 inline-flex rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white">Review requirements →</a>
        </article>
    }
    @if (Model.Matches.Count == 0) { <p class="rounded-2xl bg-white p-10 text-center text-slate-500">No currently open opportunities to match.</p> }
</div>
